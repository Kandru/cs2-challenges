/* Tracker timer: drained by the client. Server writes the start p-class, then span-N + is-running once.
   0s default so removing is-running snaps back instead of animating a refill. Must follow the ladder. */

.TrackerTimerFill
{
	transition-duration: 0s;
	transition-timing-function: linear;
}

.TrackerTimerFill.is-running { clip: rect( 0%, 0%, 100%, 0% ); }
.TrackerTimerFill.span-1 { transition-duration: 1.0s; }
.TrackerTimerFill.span-2 { transition-duration: 2.0s; }
.TrackerTimerFill.span-3 { transition-duration: 3.0s; }
.TrackerTimerFill.span-4 { transition-duration: 4.0s; }
.TrackerTimerFill.span-5 { transition-duration: 5.0s; }
.TrackerTimerFill.span-6 { transition-duration: 6.0s; }
.TrackerTimerFill.span-7 { transition-duration: 7.0s; }
.TrackerTimerFill.span-8 { transition-duration: 8.0s; }
.TrackerTimerFill.span-9 { transition-duration: 9.0s; }
.TrackerTimerFill.span-10 { transition-duration: 10.0s; }
.TrackerTimerFill.span-11 { transition-duration: 11.0s; }
.TrackerTimerFill.span-12 { transition-duration: 12.0s; }
.TrackerTimerFill.span-13 { transition-duration: 13.0s; }
.TrackerTimerFill.span-14 { transition-duration: 14.0s; }
.TrackerTimerFill.span-15 { transition-duration: 15.0s; }
.TrackerTimerFill.span-16 { transition-duration: 16.0s; }
.TrackerTimerFill.span-17 { transition-duration: 17.0s; }
.TrackerTimerFill.span-18 { transition-duration: 18.0s; }
.TrackerTimerFill.span-19 { transition-duration: 19.0s; }
.TrackerTimerFill.span-20 { transition-duration: 20.0s; }
.TrackerTimerFill.span-21 { transition-duration: 21.0s; }
.TrackerTimerFill.span-22 { transition-duration: 22.0s; }
.TrackerTimerFill.span-23 { transition-duration: 23.0s; }
.TrackerTimerFill.span-24 { transition-duration: 24.0s; }
.TrackerTimerFill.span-25 { transition-duration: 25.0s; }
.TrackerTimerFill.span-26 { transition-duration: 26.0s; }
.TrackerTimerFill.span-27 { transition-duration: 27.0s; }
.TrackerTimerFill.span-28 { transition-duration: 28.0s; }
.TrackerTimerFill.span-29 { transition-duration: 29.0s; }
.TrackerTimerFill.span-30 { transition-duration: 30.0s; }
.TrackerTimerFill.span-31 { transition-duration: 31.0s; }
.TrackerTimerFill.span-32 { transition-duration: 32.0s; }
.TrackerTimerFill.span-33 { transition-duration: 33.0s; }
.TrackerTimerFill.span-34 { transition-duration: 34.0s; }
.TrackerTimerFill.span-35 { transition-duration: 35.0s; }
.TrackerTimerFill.span-36 { transition-duration: 36.0s; }
.TrackerTimerFill.span-37 { transition-duration: 37.0s; }
.TrackerTimerFill.span-38 { transition-duration: 38.0s; }
.TrackerTimerFill.span-39 { transition-duration: 39.0s; }
.TrackerTimerFill.span-40 { transition-duration: 40.0s; }
.TrackerTimerFill.span-41 { transition-duration: 41.0s; }
.TrackerTimerFill.span-42 { transition-duration: 42.0s; }
.TrackerTimerFill.span-43 { transition-duration: 43.0s; }
.TrackerTimerFill.span-44 { transition-duration: 44.0s; }
.TrackerTimerFill.span-45 { transition-duration: 45.0s; }
.TrackerTimerFill.span-46 { transition-duration: 46.0s; }
.TrackerTimerFill.span-47 { transition-duration: 47.0s; }
.TrackerTimerFill.span-48 { transition-duration: 48.0s; }
.TrackerTimerFill.span-49 { transition-duration: 49.0s; }
.TrackerTimerFill.span-50 { transition-duration: 50.0s; }
.TrackerTimerFill.span-51 { transition-duration: 51.0s; }
