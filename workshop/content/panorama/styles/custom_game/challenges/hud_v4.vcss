/* ============================================================================
   Tracker - top-right card; tasks only (no completers).
   ============================================================================ */

.Tracker
{
	width: 420px;
	horizontal-align: right;
	vertical-align: top;
	margin-top: 10px;
	margin-right: 10px;
	z-index: 100;
}

.TrackerContent
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	overflow: noclip noclip;
	z-index: 2;
}

.TrackerBody
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 8px 12px 4px 16px;
}

.TrackerTimerRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 8px;
}

.TrackerTimerRow.is-off
{
	visibility: collapse;
}

.TrackerTimerPadL
{
	width: 16px;
	height: 1px;
}

.TrackerTimerPadR
{
	width: 12px;
	height: 1px;
}

.TrackerTimer
{
	width: fill-parent-flow( 1.0 );
}

.TrackerTimer .ph-stat-fill
{
	transition-duration: 0s;
}

.TrackerRow
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 8px 12px 8px 12px;
	margin-bottom: 8px;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

.TrackerRow.is-off
{
	visibility: collapse;
}

Label.TrackerCount
{
	margin-left: 10px;
}

.Tracker .ph-titlebar
{
	height: fit-children;
	min-height: 44px;
	padding-top: 8px;
	padding-bottom: 8px;
}

.TrackerTitleStack
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: down;
	vertical-align: middle;
}

.Tracker .ph-title
{
	width: 100%;
}

Label.TrackerHint
{
	width: 100%;
	font-size: 14;
	letter-spacing: 0px;
	text-transform: none;
	color: #a3acb6;
	margin-top: 4px;
}

Label.TrackerHint.is-off
{
	visibility: collapse;
}

.TrackerRow .ph-stat-lab
{
	height: 20px;
	margin-bottom: 4px;
}

.TrackerRow Label.ph-stat-name
{
	font-size: 16;
	letter-spacing: 1.2px;
	color: #f5f7fa;
}

.TrackerRow Label.ph-stat-val
{
	width: 52px;
	font-size: 14;
	color: #f0a531;
}

.TrackerRow .MenuRowHead
{
	margin-bottom: 8px;
}

.TrackerRowSplit
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

/* Tracker rows are one flat level: no nested box, and no "TASKS" head (the row already is the challenge). */
.TrackerRow .MenuTasksCol,
.TrackerRow .MenuByCol
{
	width: 100%;
	margin-right: 0px;
	margin-bottom: 0px;
	padding: 0px 0px 0px 0px;
	background-color: none;
	border: 0px solid #00000000;
}

.TrackerRow Label.MenuColHead
{
	visibility: collapse;
}

/* ============================================================================
   Menu - fullscreen frame (.ph-fs), list 2/3 + scoreboard 1/3.
   Challenge cards: compact header + 50/50 tasks|completers (2-col names).
   List paginated (4 cards, equal height, no scroll); scoreboard keeps ScoreTitleBar pagination.
   ============================================================================ */

.MenuRoot
{
	z-index: 300;
}

.MenuContent
{
	width: 100%;
	height: 100%;
	flow-children: down;
	z-index: 2;
}

.MenuRoot .ph-titlebar
{
	padding-right: 12px;
}

.MenuBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-left: 16px;
	padding-right: 16px;
	padding-top: 12px;
	padding-bottom: 12px;
}

/* fill-parent-flow leaves room for MenuCredit under the columns. */
.MenuColumns
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
}

.MenuList
{
	width: fill-parent-flow( 2.0 );
	height: 100%;
	flow-children: down;
	margin-right: 16px;
	overflow: clip;
}

.MenuScore
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	overflow: clip;
}

.MenuScore.is-off
{
	visibility: collapse;
}

.MenuFilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 12px;
}

.MenuFilterBtn
{
	height: 28px;
	flow-children: none;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 8px;
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	border-radius: 3px;
	wash-color: none;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.MenuFilterBtn:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.MenuFilterBtn:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.MenuFilterBtn.active
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
}

.MenuFilterBtn.active:hover
{
	background-color: #f0a53144;
	border: 1px solid #f0a531;
}

.MenuFilterBtn.is-disabled
{
	opacity: 0.4;
	wash-color: #808080;
}

.MenuFilterBtn.is-disabled:hover
{
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	cursor: default;
	sound: "";
}

.ScoreFilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 12px;
}

.ScoreFilterGroup
{
	width: fit-children;
	height: fit-children;
	flow-children: right;
}

.ScoreFilterSpacer
{
	width: fill-parent-flow( 1.0 );
	height: 1px;
}

.ScoreFilterGroup .MenuFilterBtn:last-child
{
	margin-right: 0px;
}

Label.MenuFilterLabel
{
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
	vertical-align: middle;
}

.MenuRows
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: clip;
}

.MenuRow
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-top: 8px;
	padding-bottom: 12px;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	overflow: clip;
}

/* Horizontal inset is spacers, not padding. width:100% children measure the
   border box and ignore padding, which clipped the right-aligned percent. */
.MenuRowInset
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
}

.MenuRowPad
{
	width: 12px;
	height: 100%;
}

.MenuRowBody
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

.MenuRow.is-off
{
	visibility: collapse;
}

.MenuRow.empty
{
	visibility: collapse;
}

.MenuRowHead
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	margin-bottom: 8px;
}

.MenuRow .ph-stat-lab
{
	height: 20px;
	margin-bottom: 4px;
}

.MenuRow Label.ph-stat-name
{
	font-size: 16;
	letter-spacing: 1.2px;
	color: #f5f7fa;
}

.MenuRow Label.ph-stat-val
{
	width: 56px;
	font-size: 14;
	color: #f0a531;
}

.MenuRow Label.ph-stat-when
{
	width: 150px;
	font-size: 14;
	color: #a3acb6;
}

.MenuRowSplit
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
	overflow: clip;
}

.MenuTasksCol,
.MenuByCol
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	padding: 8px 12px 8px 12px;
	background-color: #0b0f14aa;
	border: 0px solid #00000000;
	border-radius: 3px;
	overflow: clip;
}

.MenuTasksCol
{
	margin-right: 8px;
}

/* Menu columns share the tracker padding rule, but width:100% children ignore
   that padding and overflow the right edge. Spacers inset the menu columns. */
.MenuRow .MenuTasksCol,
.MenuRow .MenuByCol
{
	padding-top: 8px;
	padding-right: 0px;
	padding-bottom: 8px;
	padding-left: 0px;
}

.MenuRow .MenuTasksCol
{
	margin-right: 0px;
}

.MenuColGap
{
	width: 8px;
	height: 100%;
}

.MenuColInset
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
}

.MenuColPad
{
	width: 12px;
	height: 100%;
}

.MenuColBody
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

/* Section labels are quiet: the accent belongs to state, not to headings. */
Label.MenuColHead
{
	width: 100%;
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #a3acb6;
	margin-bottom: 4px;
}

.MenuTasks,
.MenuByList
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: clip;
}

/* Task lines are flat (no box per line). State is shown by shape and colour:
   open = accent bar, done = success check, broken = danger dash on a tinted line. */
.MenuTask
{
	width: 100%;
	height: 20px;
	flow-children: right;
	margin-bottom: 4px;
	padding-left: 4px;
	padding-right: 4px;
	background-color: #00000000;
	border-radius: 2px;
}

.MenuTask.is-off
{
	visibility: collapse;
}

.MenuTask.is-broken
{
	background-color: #e05a5a1c;
}

.MenuTaskMark
{
	width: 3px;
	height: 12px;
	margin-left: 2px;
	margin-right: 10px;
	vertical-align: middle;
	background-color: #f0a531;
	border-radius: 1px;
}

/* Check mark: an "L" (short left edge, long bottom edge) turned -45deg. */
.MenuTask.is-done .MenuTaskMark
{
	width: 10px;
	height: 5px;
	margin-left: 0px;
	margin-right: 6px;
	background-color: none;
	border-left: 2px solid #9ccf4f;
	border-bottom: 2px solid #9ccf4f;
	border-radius: 0px;
	transform: rotateZ( -45deg );
}

.MenuTask.is-broken .MenuTaskMark
{
	width: 9px;
	height: 2px;
	margin-left: 0px;
	margin-right: 6px;
	background-color: #e05a5a;
}

Label.MenuTaskLabel
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	font-size: 14;
	letter-spacing: 0.4px;
	color: #e8eef4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.MenuTask.is-done Label.MenuTaskLabel
{
	color: #9ccf4f;
}

.MenuTask.is-broken Label.MenuTaskLabel
{
	color: #e05a5a;
}

.MenuByRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 4px;
}

.MenuBy
{
	width: fill-parent-flow( 1.0 );
	height: 20px;
	flow-children: right;
	padding-left: 8px;
	padding-right: 8px;
	background-color: #ffffff0a;
	border: 1px solid #00000000;
	border-radius: 2px;
}

.MenuBy.is-off
{
	visibility: collapse;
}

.MenuByRow .MenuBy
{
	margin-left: 4px;
	margin-right: 0px;
}

.MenuByRow .MenuBy:first-child,
.MenuByRow .MenuBy.is-off
{
	margin-left: 0px;
}

.MenuBy.is-empty
{
	background-color: #00000000;
	border: 1px solid #00000000;
}

/* Own entry = accent, like the own scoreboard row (green is reserved for "done"). */
.MenuBy.is-you
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
}

.MenuBy.is-you Label.MenuByLabel
{
	color: #f5f7fa;
}

Label.MenuByLabel
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	font-size: 14;
	color: #e8eef4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.MenuBy.is-empty Label.MenuByLabel
{
	color: #a3acb6;
}

.MenuEmpty
{
	width: 100%;
	font-size: 14;
	color: #a3acb6;
	text-align: center;
	margin-top: 12px;
}

.MenuEmpty.is-off
{
	visibility: collapse;
}

/* Hardcoded English credit in menu.xml - not a dialog variable. */
Label.MenuCredit
{
	width: 100%;
	height: fit-children;
	margin-top: 8px;
	padding-top: 8px;
	border-top: 1px solid #ffffff14;
	font-size: 14;
	color: #a3acb6;
	text-align: center;
	text-overflow: shrink;
}

/* prev | [pad] title… (page) [pad] | next - equal pads center the pair; title ellipsizes; page never shrinks. */
.ScoreTitleBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 8px;
	overflow: clip;
}

.ScoreTitleCenter
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: none;
	margin-left: 6px;
	margin-right: 6px;
	vertical-align: middle;
	overflow: clip;
}

.ScoreTitleCluster
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	vertical-align: middle;
	overflow: clip;
}

.ScoreTitlePad
{
	width: fill-parent-flow( 1.0 );
	height: 1px;
}

Label.ScoreTitle
{
	width: fill-parent-flow( 1.0 );
	font-size: 16;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #f5f7fa;
	text-align: right;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
	margin-right: 6px;
}

Label.ScoreTitlePage
{
	width: fit-children;
	height: fit-children;
	font-size: 16;
	letter-spacing: 1.6px;
	color: #a3acb6;
	text-align: center;
	vertical-align: middle;
	white-space: nowrap;
}

.MenuTitleNav
{
	width: 36px;
	height: 28px;
	flow-children: none;
	vertical-align: middle;
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	border-radius: 3px;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.MenuTitleNav:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.MenuTitleNav:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.MenuTitleNav.is-disabled,
.MenuTitleNav.is-disabled:hover
{
	opacity: 0.4;
	border: 1px solid #00000000;
	background-color: #ffffff0d;
	cursor: default;
	sound: "";
}

.ScoreSelfCard
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 12px 12px 12px 12px;
	margin-bottom: 12px;
	background-color: #f0a53118;
	border: 1px solid #f0a531;
	border-radius: 3px;
}

.ScoreSelfCard.empty
{
	visibility: collapse;
}

.ScoreSelfTop
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 8px;
}

Label.ScoreSelfRank
{
	width: 48px;
	font-size: 18;
	color: #f0a531;
	vertical-align: middle;
}

Label.ScoreSelfName
{
	width: fill-parent-flow( 1.0 );
	font-size: 16;
	color: #f5f7fa;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.ScoreSelfStats
{
	width: 100%;
	height: fit-children;
	flow-children: right;
}

.ScoreSelfStat
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: down;
	padding: 8px 12px 8px 12px;
	margin-right: 8px;
	background-color: #0b0f14aa;
	border: 0px solid #00000000;
	border-radius: 3px;
}

.ScoreSelfStat:last-child
{
	margin-right: 0px;
}

Label.ScoreSelfStatLabel
{
	width: 100%;
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #a3acb6;
	margin-bottom: 4px;
}

Label.ScoreSelfStatVal
{
	width: 100%;
	font-size: 18;
	color: #f0a531;
}

.ScoreHeader
{
	width: 100%;
	height: 32px;
	flow-children: right;
	padding: 0px 12px 0px 12px;
	margin-bottom: 0px;
	background-color: #ffffff14;
	border-top: 1px solid #ffffff14;
	border-bottom: 1px solid #ffffff14;
}

Label.ScoreHead
{
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #a3acb6;
	vertical-align: middle;
}

Label.ScoreHead.sort-active
{
	color: #f0a531;
}

.ScoreRows
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: squish scroll;
	border: 1px solid #ffffff14;
	border-top: 1px solid #00000000;
	background-color: #0b0f1488;
}

.ScoreRow
{
	width: 100%;
	height: 32px;
	flow-children: right;
	padding: 0px 12px 0px 12px;
	margin-bottom: 0px;
	background-color: #00000000;
	border: 1px solid #00000000;
	border-bottom: 1px solid #ffffff0a;
	border-radius: 0px;
	wash-color: none;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.ScoreRow.alt
{
	background-color: #ffffff08;
}

.ScoreRow.empty,
.ScoreRow.is-off
{
	visibility: collapse;
}

.ScoreRow:hover
{
	background-color: #ffffff14;
	border: 1px solid #f0a53166;
	border-bottom: 1px solid #f0a53166;
}

.ScoreRow:active
{
	background-color: #ffffff1e;
	border: 1px solid #f0a531;
	border-bottom: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.ScoreRow.is-self
{
	background-color: #f0a53122;
	border-bottom: 1px solid #f0a53144;
}

.ScoreRow.is-viewing
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
	border-bottom: 1px solid #f0a531;
}

.ScoreRow.is-viewing:hover
{
	background-color: #f0a53144;
	border: 1px solid #f0a531;
	border-bottom: 1px solid #f0a531;
}

Label.ScoreRank
{
	width: 36px;
	font-size: 14;
	color: #a3acb6;
	vertical-align: middle;
}

Label.ScoreName
{
	width: fill-parent-flow( 1.0 );
	font-size: 14;
	color: #e8eef4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.ScoreCur
{
	width: 96px;
	font-size: 14;
	color: #f5f7fa;
	text-align: right;
	vertical-align: middle;
	margin-right: 12px;
}

Label.ScoreTot
{
	width: 72px;
	font-size: 14;
	color: #e8eef4;
	text-align: right;
	vertical-align: middle;
}

.ScoreHeader Label.ScoreCur,
.ScoreHeader Label.ScoreTot
{
	font-size: 14;
	color: #a3acb6;
}

.ScoreHeader Label.ScoreCur.sort-active,
.ScoreHeader Label.ScoreTot.sort-active
{
	color: #f0a531;
}

/* >>> hud_themes:begin */
/* Accent themes (gui.theme). Generated from tools/hud_themes.py - do not edit by hand. */
/* Gold is the baked-in default; other themes override accents. CT/T = stock CS2 colours. */

.theme-red .ph-bar { background-color: #e05a5a; }
.theme-red .ph-stat-fill { background-color: gradient( linear, 0% 0%, 100% 0%, from( #a83a3a ), to( #e05a5a ) ); }
.theme-red Label.ph-stat-val,
.theme-red Label.ScoreSelfRank,
.theme-red Label.ScoreSelfStatVal,
.theme-red Label.ScoreHead.sort-active,
.theme-red .ScoreHeader Label.ScoreCur.sort-active,
.theme-red .ScoreHeader Label.ScoreTot.sort-active
{ color: #e05a5a; }
.theme-red .MenuFilterBtn.active { background-color: #e05a5a22; border: 1px solid #e05a5a; }
.theme-red .MenuFilterBtn.active:hover { background-color: #e05a5a44; border: 1px solid #e05a5a; }
.theme-red .MenuFilterBtn:hover { border: 1px solid #e05a5a66; }
.theme-red .MenuFilterBtn:active { border: 1px solid #e05a5a; }
.theme-red .MenuTitleNav:hover { border: 1px solid #e05a5a66; }
.theme-red .MenuTitleNav:active { border: 1px solid #e05a5a; }
.theme-red .ScoreSelfCard { background-color: #e05a5a18; border: 1px solid #e05a5a; }
.theme-red .ScoreRow:hover { border: 1px solid #e05a5a66; border-bottom: 1px solid #e05a5a66; }
.theme-red .ScoreRow:active { border: 1px solid #e05a5a; border-bottom: 1px solid #e05a5a; }
.theme-red .ScoreRow.is-self { background-color: #e05a5a22; border-bottom: 1px solid #e05a5a44; }
.theme-red .ScoreRow.is-viewing { background-color: #e05a5a22; border: 1px solid #e05a5a; border-bottom: 1px solid #e05a5a; }
.theme-red .ScoreRow.is-viewing:hover { background-color: #e05a5a44; border: 1px solid #e05a5a; border-bottom: 1px solid #e05a5a; }
.theme-red .MenuTaskMark { background-color: #e05a5a; }
.theme-red .MenuBy.is-you { background-color: #e05a5a22; border: 1px solid #e05a5a; }

.theme-coral .ph-bar { background-color: #ff7a59; }
.theme-coral .ph-stat-fill { background-color: gradient( linear, 0% 0%, 100% 0%, from( #c44830 ), to( #ff7a59 ) ); }
.theme-coral Label.ph-stat-val,
.theme-coral Label.ScoreSelfRank,
.theme-coral Label.ScoreSelfStatVal,
.theme-coral Label.ScoreHead.sort-active,
.theme-coral .ScoreHeader Label.ScoreCur.sort-active,
.theme-coral .ScoreHeader Label.ScoreTot.sort-active
{ color: #ff7a59; }
.theme-coral .MenuFilterBtn.active { background-color: #ff7a5922; border: 1px solid #ff7a59; }
.theme-coral .MenuFilterBtn.active:hover { background-color: #ff7a5944; border: 1px solid #ff7a59; }
.theme-coral .MenuFilterBtn:hover { border: 1px solid #ff7a5966; }
.theme-coral .MenuFilterBtn:active { border: 1px solid #ff7a59; }
.theme-coral .MenuTitleNav:hover { border: 1px solid #ff7a5966; }
.theme-coral .MenuTitleNav:active { border: 1px solid #ff7a59; }
.theme-coral .ScoreSelfCard { background-color: #ff7a5918; border: 1px solid #ff7a59; }
.theme-coral .ScoreRow:hover { border: 1px solid #ff7a5966; border-bottom: 1px solid #ff7a5966; }
.theme-coral .ScoreRow:active { border: 1px solid #ff7a59; border-bottom: 1px solid #ff7a59; }
.theme-coral .ScoreRow.is-self { background-color: #ff7a5922; border-bottom: 1px solid #ff7a5944; }
.theme-coral .ScoreRow.is-viewing { background-color: #ff7a5922; border: 1px solid #ff7a59; border-bottom: 1px solid #ff7a59; }
.theme-coral .ScoreRow.is-viewing:hover { background-color: #ff7a5944; border: 1px solid #ff7a59; border-bottom: 1px solid #ff7a59; }
.theme-coral .MenuTaskMark { background-color: #ff7a59; }
.theme-coral .MenuBy.is-you { background-color: #ff7a5922; border: 1px solid #ff7a59; }

.theme-orange .ph-bar { background-color: #ff8a3d; }
.theme-orange .ph-stat-fill { background-color: gradient( linear, 0% 0%, 100% 0%, from( #c45a1a ), to( #ff8a3d ) ); }
.theme-orange Label.ph-stat-val,
.theme-orange Label.ScoreSelfRank,
.theme-orange Label.ScoreSelfStatVal,
.theme-orange Label.ScoreHead.sort-active,
.theme-orange .ScoreHeader Label.ScoreCur.sort-active,
.theme-orange .ScoreHeader Label.ScoreTot.sort-active
{ color: #ff8a3d; }
.theme-orange .MenuFilterBtn.active { background-color: #ff8a3d22; border: 1px solid #ff8a3d; }
.theme-orange .MenuFilterBtn.active:hover { background-color: #ff8a3d44; border: 1px solid #ff8a3d; }
.theme-orange .MenuFilterBtn:hover { border: 1px solid #ff8a3d66; }
.theme-orange .MenuFilterBtn:active { border: 1px solid #ff8a3d; }
.theme-orange .MenuTitleNav:hover { border: 1px solid #ff8a3d66; }
.theme-orange .MenuTitleNav:active { border: 1px solid #ff8a3d; }
.theme-orange .ScoreSelfCard { background-color: #ff8a3d18; border: 1px solid #ff8a3d; }
.theme-orange .ScoreRow:hover { border: 1px solid #ff8a3d66; border-bottom: 1px solid #ff8a3d66; }
.theme-orange .ScoreRow:active { border: 1px solid #ff8a3d; border-bottom: 1px solid #ff8a3d; }
.theme-orange .ScoreRow.is-self { background-color: #ff8a3d22; border-bottom: 1px solid #ff8a3d44; }
.theme-orange .ScoreRow.is-viewing { background-color: #ff8a3d22; border: 1px solid #ff8a3d; border-bottom: 1px solid #ff8a3d; }
.theme-orange .ScoreRow.is-viewing:hover { background-color: #ff8a3d44; border: 1px solid #ff8a3d; border-bottom: 1px solid #ff8a3d; }
.theme-orange .MenuTaskMark { background-color: #ff8a3d; }
.theme-orange .MenuBy.is-you { background-color: #ff8a3d22; border: 1px solid #ff8a3d; }

.theme-copper .ph-bar { background-color: #e08a5a; }
.theme-copper .ph-stat-fill { background-color: gradient( linear, 0% 0%, 100% 0%, from( #a85a30 ), to( #e08a5a ) ); }
.theme-copper Label.ph-stat-val,
.theme-copper Label.ScoreSelfRank,
.theme-copper Label.ScoreSelfStatVal,
.theme-copper Label.ScoreHead.sort-active,
.theme-copper .ScoreHeader Label.ScoreCur.sort-active,
.theme-copper .ScoreHeader Label.ScoreTot.sort-active
{ color: #e08a5a; }
.theme-copper .MenuFilterBtn.active { background-color: #e08a5a22; border: 1px solid #e08a5a; }
.theme-copper .MenuFilterBtn.active:hover { background-color: #e08a5a44; border: 1px solid #e08a5a; }
.theme-copper .MenuFilterBtn:hover { border: 1px solid #e08a5a66; }
.theme-copper .MenuFilterBtn:active { border: 1px solid #e08a5a; }
.theme-copper .MenuTitleNav:hover { border: 1px solid #e08a5a66; }
