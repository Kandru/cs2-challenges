/* ============================================================================
   Challenges HUD - one stylesheet for tracker.xml and menu.xml.
   Shared chrome comes from the Prophunt kit (workshop/example/hud.vcss).
   Hex colours only; no @define/var/rgba/display. Bars use clip ladders (p0 ... p100).
   Hide with ph-off (cards) / is-off (rows). Do not name a class "hidden".

   Tokens (v4): surface #12171e/#0b0f14  raised #ffffff0d  hover #ffffff1c  press #ffffff2e
                border #ffffff14  ink #f5f7fa  ink-soft #e8eef4  muted #a3acb6  dim #6b737c
                accent = theme (gold #f0a531)  success #9ccf4f  warn #ff8a3d  danger #e05a5a
   Accent only for: active state, bars, accent bar, sorted column, own entries.
   Semantic colours (success/danger) never follow the theme. Spacing on a 4px grid.
   Type scale 14 / 16 / 18. Motion: hover 0.15s, menu 0.25s in / 0.18s out, tracker 1.0s.
   ============================================================================ */

/* Shared chrome */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.HudScreen.TrackerScreen
{
	z-index: 99998;
}

.ph-card
{
	opacity: 1;
	transform: translateY( 0px ) scale3d( 1, 1, 1 );
	brightness: 1;
	transition-property: opacity, transform, brightness;
	transition-duration: 1.0s;
	transition-timing-function: ease-out;
	overflow: noclip noclip;
	border-radius: 3px;
}

.ph-card.ph-fading
{
	opacity: 0;
}

/* Not "hidden" - that name exists on csgostyles and would collide. */
.ph-card.ph-off
{
	visibility: collapse;
	opacity: 0;
	transition-duration: 0s;
}

/* Interactive menu: quick enter (0.25s, ease-out) and quicker exit (0.18s, ease-in, 8px drop).
   The passive tracker keeps the slow 1.0s fade above. */
.MenuRoot.ph-card
{
	transition-duration: 0.25s;
}

.MenuRoot.ph-card.ph-fading
{
	transform: translateY( 8px ) scale3d( 1, 1, 1 );
	transition-duration: 0.18s;
	transition-timing-function: ease-in;
}

.MenuRoot.ph-card.ph-off
{
	transition-duration: 0s;
}

.ph-bg
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #12171ee8 ), to( #0b0f14f2 ) );
	background-image: url("s2r://panorama/images/backgrounds/bluedots_large_png.vtex");
	background-size: 360px 360px;
	background-repeat: repeat;
	background-img-opacity: 0.03;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	box-shadow: #000000c0 0px 8px 30px 0px;
	world-blur: gaussian( 2 );
	z-index: 0;
}

.ph-bar
{
	width: 3px;
	height: 100%;
	background-color: #f0a531;
	z-index: 5;
}

.ph-bar-left
{
	horizontal-align: left;
}

.ph-bar-right
{
	horizontal-align: right;
}

/* Fullscreen shell - 68px inset clears RoundStatus (4px + 60px + 4px gap).
   Content uses fill-parent-flow / fit-children; ph-bg uses ignore-parent-flow.
   PropGrid cannot use this (asymmetric 68/36 inset + flow children) - see spacers. */
.ph-fs
{
	width: 100%;
	height: 100%;
	padding-top: 68px;
	padding-right: 68px;
	padding-bottom: 68px;
	padding-left: 68px;
}

/* Shared title row - Prop/Sound/Weapon/Shop/Rules. */
.ph-titlebar
{
	width: 100%;
	height: 44px;
	flow-children: right;
	padding-left: 16px;
	padding-right: 16px;
	background-color: #ffffff14;
	border-bottom: 1px solid #ffffff14;
}

Label.ph-title
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 16;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #f5f7fa;
}

Label.ph-money
{
	vertical-align: middle;
	font-size: 14;
	letter-spacing: 1px;
	color: #9ccf4f;
}

/* Button label: parent must be flow-children:none. No height:100% - that
   pins the glyph to the top and makes vertical-align a no-op. */
Label.ph-btn-label
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
}

/* Shared title-bar icon buttons (close X, stop, maximize) + Prev/Next label. */
.ph-icon-btn
{
	width: 28px;
	height: 28px;
	flow-children: none;
	background-color: #ffffff0d;
	border: 0px solid transparent;
	border-radius: 3px;
	vertical-align: middle;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.ph-icon-btn:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.ph-icon-btn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

/* The title-bar icon button is the close X: exit gets the danger tint. */
.ph-titlebar .ph-icon-btn:hover
{
	background-color: #e05a5a44;
}

.ph-titlebar .ph-icon-btn:active
{
	background-color: #e05a5a88;
}

.ph-close-x
{
	width: 12px;
	height: 2px;
	horizontal-align: center;
	vertical-align: middle;
	background-color: #f5f7fa;
	border-radius: 1px;
}

.ph-close-x-a
{
	transform: rotateZ( 45deg );
}

.ph-close-x-b
{
	transform: rotateZ( -45deg );
}

Label.ph-nav-label
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 14;
	color: #e8eef4;
}

.ph-stat
{
	width: 100%;
	flow-children: down;
}

.ph-stat.is-off
{
	visibility: collapse;
}

.ph-stat-lab
{
	width: 100%;
	height: 18px;
	flow-children: right;
	margin-bottom: 6px;
}

Label.ph-stat-name
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #e8eef4;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
}

Label.ph-stat-val
{
	width: 72px;
	height: 100%;
	font-size: 14;
	color: #f0a531;
	text-align: right;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
}

Label.ph-stat-when
{
	width: 150px;
	height: 100%;
	font-size: 14;
	color: #a3acb6;
	text-align: right;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
	margin-right: 8px;
}

.ph-stat-track
{
	width: 100%;
	height: 6px;
	flow-children: none;
	border-radius: 3px;
	background-color: #ffffff12;
	overflow: clip;
}

.ph-stat-fill
{
	height: 100%;
	width: 100%;
	border-radius: 3px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( #f0a531 ), to( #ffd27a ) );
	transition-property: clip;
	transition-duration: 0.35s;
	clip: rect( 0%, 0%, 100%, 0% );
}

.ph-stat-fill.p100 { clip: rect( 0%, 100%, 100%, 0% ); }
.ph-stat-fill.p99 { clip: rect( 0%, 99%, 100%, 0% ); }
.ph-stat-fill.p98 { clip: rect( 0%, 98%, 100%, 0% ); }
.ph-stat-fill.p97 { clip: rect( 0%, 97%, 100%, 0% ); }
.ph-stat-fill.p96 { clip: rect( 0%, 96%, 100%, 0% ); }
.ph-stat-fill.p95 { clip: rect( 0%, 95%, 100%, 0% ); }
.ph-stat-fill.p94 { clip: rect( 0%, 94%, 100%, 0% ); }
