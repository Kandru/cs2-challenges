/* Tracker timer: drained by the client. Server writes the start p-class, then span-N + is-running once.
   0s default so removing is-running snaps back instead of animating a refill. Must follow the ladder. */

.TrackerTimerFill
{
	transition-duration: 0s;
	transition-timing-function: linear;
}

.TrackerTimerFill.is-running { clip: rect( 0%, 0%, 100%, 0% ); }
.TrackerTimerFill.span-1 { transition-duration: 1.0s; }
.TrackerTimerFill.span-2 { transition-duration: 2.0s; }
.TrackerTimerFill.span-3 { transition-duration: 3.0s; }
.TrackerTimerFill.span-4 { transition-duration: 4.0s; }
.TrackerTimerFill.span-5 { transition-duration: 5.0s; }
