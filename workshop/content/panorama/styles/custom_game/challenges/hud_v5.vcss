/* >>> hud_themes:begin */
/* Accent themes (gui.theme). Generated from tools/hud_themes.py - do not edit by hand. */
/* Gold is the baked-in default; other themes override accents. CT/T = stock CS2 colours. */

.theme-red .ph-stat-fill { background-color: gradient( linear, 0% 0%, 100% 0%, from( #a83a3a ), to( #e05a5a ) ); }
.theme-red Label.TxKicker,
.theme-red Label.TxIdxLabel,
.theme-red Label.TxCardPct,
.theme-red Label.TxRowPct,
.theme-red .TxNav.active Label.TxNavCount,
.theme-red Label.ScoreSelfRank,
.theme-red Label.ScoreHead.sort-active,
.theme-red .ScoreHeader Label.ScoreCur.sort-active,
.theme-red .ScoreHeader Label.ScoreTot.sort-active
{ color: #e05a5a; }
.theme-red .TxCorner { border-top: 2px solid #e05a5a; border-left: 2px solid #e05a5a; }
.theme-red .TxIdx { border: 1px solid #e05a5a; }
.theme-red .TxNav.active { background-color: #e05a5a1f; border-left: 3px solid #e05a5a; }
.theme-red .TxChip:hover { border: 1px solid #e05a5a66; }
.theme-red .TxChip.active { background-color: #e05a5a1f; border: 1px solid #e05a5a; }
.theme-red .MenuTitleNav:hover { border: 1px solid #e05a5a66; }
.theme-red .MenuTitleNav:active { border: 1px solid #e05a5a; }
.theme-red .ScoreSelfCard { background-color: #e05a5a14; border: 1px solid #e05a5a; }
.theme-red .ScoreRow.is-self { background-color: #e05a5a1a; border-left: 3px solid #e05a5a; }
.theme-red .ScoreRow.is-viewing { background-color: #e05a5a2e; border-left: 3px solid #e05a5a; }
