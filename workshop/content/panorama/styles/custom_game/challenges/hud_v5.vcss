/* ============================================================================
   Challenges HUD v5 - "tactical" design, one stylesheet for tracker_v5.xml and menu_v5.xml.
   Hex colours only; no @define/var/rgba/display. Bars use clip ladders (p0 ... p100).
   Hide with ph-off (cards) / is-off (rows). Do not name a class "hidden".

   Tokens: panel #0a0d11eb  card #ffffff08  hairline #ffffff1f / #ffffff14
           ink #f5f7fa  ink-soft #e8eef4  muted #a3acb6  cut #10141a
           accent = theme (gold #f0a531)  success #9ccf4f  danger #e05a5a
           medals #f0c64a / #c9d2dc / #d08a4e
   Language: square corners, accent corner brackets, "//" kickers, segmented bars,
   checkbox task marks (open = empty box, done = filled, broken = red box on a red line).
   Accent only for: brackets, kickers, index boxes, values, active state, own entries.
   Semantic colours never follow the theme. Type scale 14 / 16 / 18 / 20 / 28.
   Spacing on a 4px grid; horizontal insets are TxPad spacers (width:100% children
   ignore padding). Motion: hover 0.15s, menu 0.25s in / 0.18s out, tracker 1.0s.
   ============================================================================ */

/* Shared chrome ---------------------------------------------------------------- */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.HudScreen.TrackerScreen
{
	z-index: 99998;
}

.ph-card
{
	opacity: 1;
	transform: translateY( 0px ) scale3d( 1, 1, 1 );
	transition-property: opacity, transform;
	transition-duration: 1.0s;
	transition-timing-function: ease-out;
	overflow: noclip noclip;
}

.ph-card.ph-fading
{
	opacity: 0;
}

/* Not "hidden" - that name exists on csgostyles and would collide. */
.ph-card.ph-off
{
	visibility: collapse;
	opacity: 0;
	transition-duration: 0s;
}

.MenuRoot.ph-card
{
	transition-duration: 0.25s;
}

.MenuRoot.ph-card.ph-fading
{
	transform: translateY( 8px ) scale3d( 1, 1, 1 );
	transition-duration: 0.18s;
	transition-timing-function: ease-in;
}

.MenuRoot.ph-card.ph-off
{
	transition-duration: 0s;
}

.ph-bg
{
	width: 100%;
	height: 100%;
	background-color: #0a0d11eb;
	border: 1px solid #ffffff1f;
	box-shadow: #000000b0 0px 10px 32px 0px;
	world-blur: gaussian( 2 );
	z-index: 0;
}

/* Fullscreen shell - 68px inset clears the round status. */
.ph-fs
{
	width: 100%;
	height: 100%;
	padding-top: 68px;
	padding-right: 68px;
	padding-bottom: 68px;
	padding-left: 68px;
}

/* Corner brackets: one top+left "L", turned for the other corners. */
.TxCorner
{
	width: 12px;
	height: 12px;
	border-top: 2px solid #f0a531;
	border-left: 2px solid #f0a531;
	z-index: 6;
}

.TxCornerTL
{
	horizontal-align: left;
	vertical-align: top;
}

.TxCornerTR
{
	horizontal-align: right;
	vertical-align: top;
	transform: rotateZ( 90deg );
}

.TxCornerBR
{
	horizontal-align: right;
	vertical-align: bottom;
	transform: rotateZ( 180deg );
}

.TxCornerBL
{
	horizontal-align: left;
	vertical-align: bottom;
	transform: rotateZ( 270deg );
}

.TxPad
{
	width: 16px;
	height: 100%;
}

.TxVPad
{
	width: 100%;
	height: 16px;
}

/* Panel head: "// TITLE  sub ......  03/12  [x]" */
.TxHead
{
	width: 100%;
	height: 52px;
	flow-children: right;
	padding-left: 20px;
	padding-right: 16px;
	border-bottom: 1px solid #ffffff14;
}

Label.TxKicker
{
	vertical-align: middle;
	margin-right: 10px;
	font-size: 16;
	letter-spacing: 1px;
	color: #f0a531;
}

Label.TxTitle
{
	vertical-align: middle;
	font-size: 20;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #f5f7fa;
}

Label.TxHeadSub
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	margin-left: 16px;
	font-size: 16;
	letter-spacing: 1px;
	color: #a3acb6;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.TxCount
{
	vertical-align: middle;
	margin-left: 16px;
	font-size: 28;
	letter-spacing: 1px;
	color: #f5f7fa;
}

.TxClose
{
	margin-left: 16px;
}

.ph-icon-btn
{
	width: 32px;
	height: 32px;
	flow-children: none;
	vertical-align: middle;
	background-color: #ffffff08;
	border: 1px solid #ffffff33;
	wash-color: none;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.ph-icon-btn:hover
{
	background-color: #e05a5a44;
	border: 1px solid #e05a5a;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.ph-icon-btn:active
{
	background-color: #e05a5a88;
	sound: "UIPanorama.generic_button_press";
}

.ph-close-x
{
	width: 14px;
	height: 2px;
	horizontal-align: center;
	vertical-align: middle;
	background-color: #f5f7fa;
}

.ph-close-x-a
{
	transform: rotateZ( 45deg );
}

.ph-close-x-b
{
	transform: rotateZ( -45deg );
}

Label.ph-nav-label
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 16;
	color: #e8eef4;
}

/* Index box "01" */
.TxIdx
{
	width: 32px;
	height: 24px;
	flow-children: none;
	vertical-align: middle;
	margin-right: 12px;
	border: 1px solid #f0a531;
}

Label.TxIdxLabel
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 14;
	letter-spacing: 1px;
	color: #f0a531;
}

/* Segmented bar: a clip-ladder fill under ten cut cells. */
.TxSeg
{
	width: 100%;
	height: 6px;
	margin-top: 12px;
	margin-bottom: 8px;
	flow-children: none;
}

.ph-stat-track
{
	width: 100%;
	height: 6px;
	flow-children: none;
	background-color: #ffffff14;
	overflow: clip;
}

.ph-stat-fill
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( #f0a531 ), to( #ffd27a ) );
	clip: rect( 0%, 0%, 100%, 0% );
	transition-property: clip;
	transition-duration: 0.35s;
	transition-timing-function: ease-out;
}

.TxSegCuts
{
	width: 100%;
	height: 100%;
	margin-left: -3px;
	flow-children: right;
	z-index: 3;
}

.TxSegCut
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	border-left: 3px solid #10141a;
}

/* Task lines: checkbox marks. */
.MenuTasks
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

.MenuTask
{
	width: 100%;
	height: 24px;
	flow-children: right;
}

.MenuTask.is-off
{
	visibility: collapse;
}

.MenuTask.is-broken
{
	background-color: #e05a5a14;
}

.MenuTaskMark
{
	width: 12px;
	height: 12px;
	margin-left: 2px;
	margin-right: 10px;
	vertical-align: middle;
	background-color: none;
	border: 2px solid #ffffff55;
}

.MenuTask.is-done .MenuTaskMark
{
	background-color: #9ccf4f;
	border: 2px solid #9ccf4f;
}

.MenuTask.is-broken .MenuTaskMark
{
	background-color: #e05a5a66;
	border: 2px solid #e05a5a;
}

Label.MenuTaskLabel
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 15;
	letter-spacing: 0.3px;
	color: #e8eef4;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.MenuTask.is-done Label.MenuTaskLabel
{
	color: #9ccf4f;
}

.MenuTask.is-broken Label.MenuTaskLabel
{
	color: #e05a5a;
}

/* Tracker ---------------------------------------------------------------------- */

.Tracker
{
	width: 420px;
	horizontal-align: right;
	vertical-align: top;
	margin-top: 10px;
	margin-right: 10px;
	flow-children: none;
	z-index: 100;
}

.TrackerContent
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	z-index: 2;
}

.Tracker .TxHead
{
	height: 48px;
	padding-left: 16px;
}

.Tracker Label.TxTitle
{
	width: fill-parent-flow( 1.0 );
	font-size: 18;
}

.Tracker Label.TxCount
{
	font-size: 22;
}

.TrackerBody
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

.TrackerRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	padding-top: 12px;
	padding-bottom: 10px;
	border-bottom: 1px solid #ffffff10;
}

.TrackerRow.is-off
{
	visibility: collapse;
}

.TrackerRow .TxPad
{
	height: 1px;
}

.TxCardBody
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

.TrackerRow .TxCardBody
{
	height: fit-children;
}

.TxCardHead
{
	width: 100%;
	height: 28px;
	flow-children: right;
}

.TrackerRow .TxCardHead
{
	height: 24px;
}

.TrackerRow .TxIdx
{
	width: 28px;
	height: 20px;
	margin-right: 10px;
}

.TrackerRow .TxSeg
{
	margin-top: 8px;
	margin-bottom: 8px;
}

.TrackerRow .MenuTask
{
	height: 22px;
}

Label.TxRowTitle
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 16;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.TxRowPct
{
	vertical-align: middle;
	margin-left: 12px;
	font-size: 18;
	color: #f0a531;
}

Label.TrackerHint
{
	margin-top: 10px;
	margin-left: 16px;
	font-size: 14;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #a3acb6;
}

Label.TrackerHint.is-off
{
	visibility: collapse;
}

.TrackerTimerRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-top: 10px;
	margin-bottom: 12px;
}

.TrackerTimerRow.is-off
{
	visibility: collapse;
}

.TrackerTimerRow .TxPad
{
	height: 1px;
}

.TrackerTimer
{
	width: fill-parent-flow( 1.0 );
	height: 3px;
}

/* Menu: frame ------------------------------------------------------------------ */

.MenuRoot
{
	z-index: 300;
}

.MenuColumns
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.TxPanel
{
	height: 100%;
	flow-children: none;
}

.MenuMain
{
	width: fill-parent-flow( 1.0 );
}

.TxColGap
{
	width: 16px;
	height: 100%;
}

.MenuScore
{
	width: 420px;
}

.MenuScore.is-off
{
	visibility: collapse;
}

.TxPanelContent
{
	width: 100%;
	height: 100%;
	flow-children: down;
	z-index: 2;
}

.MenuBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
}

/* Menu: filter rail ------------------------------------------------------------ */

.TxRail
{
	width: 220px;
	height: 100%;
	flow-children: down;
	padding-top: 16px;
}

Label.TxRailHead
{
	margin-left: 16px;
	margin-bottom: 8px;
	font-size: 14;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: #a3acb6;
}

.TxNav
{
	width: 100%;
	height: 36px;
	flow-children: right;
	padding-left: 13px;
	padding-right: 16px;
	margin-bottom: 2px;
	background-color: #00000000;
	border-left: 3px solid #00000000;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.TxNav:hover
{
	background-color: #ffffff0d;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.TxNav:active
{
	background-color: #ffffff1a;
	sound: "UIPanorama.generic_button_press";
}

.TxNav.active
{
	background-color: #f0a5311f;
	border-left: 3px solid #f0a531;
}

.TxNav.is-disabled
{
	opacity: 0.4;
}

.TxNav.is-disabled:hover
{
	background-color: #00000000;
	cursor: default;
	sound: "";
}

Label.TxNavLabel
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 16;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #e8eef4;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.TxNavCount
{
	vertical-align: middle;
	margin-left: 8px;
	font-size: 16;
	color: #a3acb6;
}

.TxNav.active Label.TxNavLabel
{
	color: #f5f7fa;
}

.TxNav.active Label.TxNavCount
{
	color: #f0a531;
}

/* Menu: card grid -------------------------------------------------------------- */

.MenuList
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: right;
	border-left: 1px solid #ffffff14;
}

.TxListInner
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

.TxListBar
{
	width: 100%;
	height: 32px;
	flow-children: right;
	margin-bottom: 12px;
}

Label.TxListPage
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 14;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: #a3acb6;
}

.MenuTitleNav
{
	width: 36px;
	height: 28px;
	flow-children: none;
	vertical-align: middle;
	margin-left: 8px;
	background-color: #ffffff08;
	border: 1px solid #ffffff1f;
	wash-color: none;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.MenuTitleNav:hover
{
	background-color: #ffffff14;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.MenuTitleNav:active
{
	background-color: #ffffff24;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.MenuTitleNav.is-disabled,
.MenuTitleNav.is-disabled:hover
{
	opacity: 0.4;
	background-color: #ffffff08;
	border: 1px solid #ffffff1f;
	cursor: default;
	sound: "";
}

.MenuRows
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
}

.TxGridRow
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
	margin-bottom: 12px;
}

.TxGridGap
{
	width: 12px;
	height: 100%;
}

.MenuRow
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: right;
	padding-top: 14px;
	padding-bottom: 14px;
	background-color: #ffffff08;
	border: 1px solid #ffffff14;
	overflow: clip;
}

/* An unused slot keeps its place in the grid. */
.MenuRow.empty
{
	opacity: 0;
}

.MenuRow.is-off
{
	visibility: collapse;
}

Label.TxCardTitle
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 18;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.TxCardPct
{
	vertical-align: middle;
	margin-left: 12px;
	font-size: 24;
	color: #f0a531;
}

Label.TxWhen
{
	margin-bottom: 10px;
	font-size: 14;
	color: #a3acb6;
}

Label.TxSection
{
	margin-top: 12px;
	margin-bottom: 6px;
	font-size: 14;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: #a3acb6;
}

.MenuByList
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

.MenuByRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 6px;
}

.MenuBy
{
	width: fit-children;
	height: 24px;
	flow-children: right;
	padding-left: 10px;
	padding-right: 10px;
	margin-right: 6px;
	background-color: #ffffff08;
	border: 1px solid #ffffff1f;
}

.MenuBy.is-off
{
	visibility: collapse;
}

.MenuBy.is-empty
{
	padding-left: 0px;
	background-color: #00000000;
	border: 1px solid #00000000;
}

.MenuBy.is-you
{
	background-color: #f0a5311f;
	border: 1px solid #f0a531;
}

Label.MenuByLabel
{
	max-width: 160px;
	vertical-align: middle;
	font-size: 14;
	color: #e8eef4;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.MenuBy.is-empty Label.MenuByLabel
{
	color: #a3acb6;
}

.MenuBy.is-you Label.MenuByLabel
{
	color: #f5f7fa;
}

Label.MenuEmpty
{
	width: 100%;
	margin-top: 24px;
	font-size: 16;
	text-align: center;
	color: #a3acb6;
}

Label.MenuEmpty.is-off
{
	visibility: collapse;
}

/* Hardcoded English credit in menu.xml - not a dialog variable. */
Label.MenuCredit
{
	width: 100%;
	padding-top: 8px;
	padding-bottom: 8px;
	border-top: 1px solid #ffffff14;
	font-size: 14;
	color: #a3acb6;
	text-align: center;
	text-overflow: shrink;
}

/* Menu: scoreboard ------------------------------------------------------------- */

.MenuScore Label.TxTitle
{
	width: fill-parent-flow( 1.0 );
}

.MenuScore Label.TxListPage
{
	width: fit-children;
	margin-right: 4px;
}

.ScoreBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
}

.ScoreInner
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

.ScoreFilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 14px;
}

.ScoreFilterGroup
{
	width: fit-children;
	height: fit-children;
	flow-children: right;
}

.ScoreFilterSpacer
{
	width: fill-parent-flow( 1.0 );
	height: 1px;
}

.TxChip
{
	height: 28px;
	flow-children: none;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 6px;
	background-color: #ffffff08;
	border: 1px solid #ffffff1f;
	wash-color: none;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.TxChip:last-child
{
	margin-right: 0px;
}

.TxChip:hover
{
	background-color: #ffffff14;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.TxChip:active
{
	background-color: #ffffff24;
	sound: "UIPanorama.generic_button_press";
}

.TxChip.active
{
	background-color: #f0a5311f;
	border: 1px solid #f0a531;
}

Label.TxChipLabel
{
	vertical-align: middle;
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
}

.TxChip.active Label.TxChipLabel
{
	color: #f5f7fa;
}

.ScoreSelfCard
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding-top: 12px;
	padding-bottom: 12px;
	margin-bottom: 14px;
	background-color: #f0a53114;
	border: 1px solid #f0a531;
	wash-color: none;
}

.ScoreSelfCard.empty
{
	visibility: collapse;
}

.ScoreSelfTop
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-left: 14px;
	margin-bottom: 8px;
}

Label.ScoreSelfRank
{
	width: 64px;
	vertical-align: middle;
	font-size: 28;
	color: #f0a531;
}

Label.ScoreSelfName
{
	width: 280px;
	vertical-align: middle;
	font-size: 18;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.ScoreSelfStats
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-left: 14px;
}

.ScoreSelfStat
{
	width: 168px;
	height: fit-children;
	flow-children: down;
	padding: 8px 12px 8px 12px;
	margin-right: 8px;
	background-color: #0a0d11aa;
}

Label.ScoreSelfStatLabel
{
	margin-bottom: 4px;
	font-size: 14;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #a3acb6;
}

Label.ScoreSelfStatVal
{
	font-size: 18;
	color: #f5f7fa;
}

.ScoreHeader
{
	width: 100%;
	height: 32px;
	flow-children: right;
	padding-left: 12px;
	padding-right: 12px;
	border-bottom: 1px solid #ffffff1f;
}

Label.ScoreHead
{
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #a3acb6;
	vertical-align: middle;
}

Label.ScoreHead.sort-active
{
	color: #f0a531;
}

.ScoreRows
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: clip;
}

.ScoreRow
{
	width: 100%;
	height: 36px;
	flow-children: right;
	padding-left: 9px;
	padding-right: 12px;
	background-color: #00000000;
	border-left: 3px solid #00000000;
	border-bottom: 1px solid #ffffff10;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.ScoreRow.alt
{
	background-color: #ffffff05;
}

.ScoreRow.empty,
.ScoreRow.is-off
{
	visibility: collapse;
}

.ScoreRow:hover
{
	background-color: #ffffff0d;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.ScoreRow:active
{
	background-color: #ffffff1a;
	sound: "UIPanorama.generic_button_press";
}

.ScoreRow.is-self
{
	background-color: #f0a5311a;
	border-left: 3px solid #f0a531;
}

.ScoreRow.is-viewing
{
	background-color: #f0a5312e;
	border-left: 3px solid #f0a531;
}

Label.ScoreRank
{
	width: 36px;
	vertical-align: middle;
	font-size: 16;
	color: #a3acb6;
}

.ScoreRow.rank-1 Label.ScoreRank
{
	color: #f0c64a;
}

.ScoreRow.rank-2 Label.ScoreRank
{
	color: #c9d2dc;
}

.ScoreRow.rank-3 Label.ScoreRank
{
	color: #d08a4e;
}

Label.ScoreName
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 16;
	color: #e8eef4;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.ScoreCur
{
	width: 72px;
	vertical-align: middle;
	margin-right: 12px;
	font-size: 16;
	text-align: right;
	color: #f5f7fa;
}

Label.ScoreTot
{
	width: 64px;
	vertical-align: middle;
	font-size: 16;
	text-align: right;
	color: #a3acb6;
}

.ScoreHeader Label.ScoreRank,
.ScoreHeader Label.ScoreName,
.ScoreHeader Label.ScoreCur,
.ScoreHeader Label.ScoreTot
{
	font-size: 14;
	color: #a3acb6;
}

.ScoreHeader Label.ScoreCur.sort-active,
.ScoreHeader Label.ScoreTot.sort-active
{
	color: #f0a531;
}

