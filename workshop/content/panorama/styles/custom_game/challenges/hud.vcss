/* ============================================================================
   Tracker - top-right card; tasks only (no completers).
   ============================================================================ */

.Tracker
{
	width: 420px;
	horizontal-align: right;
	vertical-align: top;
	margin-top: 10px;
	margin-right: 10px;
	z-index: 100;
}

.TrackerContent
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	overflow: noclip noclip;
	z-index: 2;
}

.TrackerBody
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 8px 12px 6px 14px;
}

.TrackerTimerRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 8px;
}

.TrackerTimerRow.is-off
{
	visibility: collapse;
}

.TrackerTimerPadL
{
	width: 14px;
	height: 1px;
}

.TrackerTimerPadR
{
	width: 12px;
	height: 1px;
}

.TrackerTimer
{
	width: fill-parent-flow( 1.0 );
}

.TrackerTimer .ph-stat-fill
{
	transition-duration: 0s;
}

.TrackerRow
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 8px 8px 8px 8px;
	margin-bottom: 6px;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

.TrackerRow.is-off
{
	visibility: collapse;
}

Label.TrackerCount
{
	margin-left: 10px;
}

.Tracker .ph-titlebar
{
	height: fit-children;
	min-height: 44px;
	padding-top: 8px;
	padding-bottom: 8px;
}

.TrackerTitleStack
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: down;
	vertical-align: middle;
}

.Tracker .ph-title
{
	width: 100%;
}

Label.TrackerHint
{
	width: 100%;
	font-size: 14;
	letter-spacing: 0px;
	text-transform: none;
	color: #9aa2ac;
	margin-top: 2px;
}

Label.TrackerHint.is-off
{
	visibility: collapse;
}

.TrackerRow .ph-stat-lab
{
	height: 16px;
	margin-bottom: 4px;
}

.TrackerRow Label.ph-stat-name
{
	font-size: 14;
	letter-spacing: 1.2px;
	color: #e8eef4;
}

.TrackerRow Label.ph-stat-val
{
	width: 52px;
	font-size: 14;
	color: #f0a531;
}

.TrackerRow .MenuRowHead
{
	margin-bottom: 6px;
}

.TrackerRowSplit
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

.TrackerRow .MenuTasksCol,
.TrackerRow .MenuByCol
{
	width: 100%;
	margin-right: 0px;
	margin-bottom: 4px;
	padding: 6px 8px 6px 8px;
}

.TrackerRow .MenuByCol
{
	margin-bottom: 0px;
}

/* ============================================================================
   Menu - fullscreen frame (.ph-fs), list 2/3 + scoreboard 1/3.
   Challenge cards: compact header + 50/50 tasks|completers (2-col names).
   List + detail scroll; scoreboard keeps ScoreTitleBar pagination.
   ============================================================================ */

.MenuRoot
{
	z-index: 300;
}

.MenuContent
{
	width: 100%;
	height: 100%;
	flow-children: down;
	z-index: 2;
}

.MenuRoot .ph-titlebar
{
	padding-right: 12px;
}

.MenuBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-left: 18px;
	padding-right: 18px;
	padding-top: 12px;
	padding-bottom: 12px;
}

/* fill-parent-flow leaves room for MenuCredit under the columns. */
.MenuColumns
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right;
}

.MenuList
{
	width: fill-parent-flow( 2.0 );
	height: 100%;
	flow-children: down;
	margin-right: 18px;
	overflow: clip;
}

.MenuScore
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	overflow: clip;
}

.MenuDetail
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	overflow: clip;
}

.MenuScore.is-off,
.MenuDetail.is-off
{
	visibility: collapse;
}

.DetailTitleBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 8px;
	overflow: clip;
}

.DetailBackInline
{
	width: fit-children;
	height: 28px;
	margin-right: 8px;
	vertical-align: middle;
	overflow: clip;
}

.DetailBackInline Label.MenuFilterLabel
{
	width: fit-children;
	text-align: center;
	text-overflow: ellipsis;
}

Label.DetailTitle
{
	width: fill-parent-flow( 1.0 );
	font-size: 15;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #e8eef4;
	text-align: left;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.DetailRows
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: squish scroll;
	padding-right: 12px;
}

.DetailRow
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 8px 10px 8px 10px;
	margin-bottom: 6px;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

.DetailRow.empty,
.DetailRow.is-off
{
	visibility: collapse;
}

.DetailRow.is-done
{
	background-color: #9ccf4f18;
	border: 1px solid #9ccf4f44;
}

.DetailRow.is-broken
{
	background-color: #e05a5a22;
	border: 1px solid #e05a5a66;
}

Label.DetailTaskTitle
{
	width: 100%;
	font-size: 14;
	letter-spacing: 1px;
	color: #e8eef4;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.DetailRow.is-done Label.DetailTaskTitle
{
	color: #9ccf4f;
}

.DetailRow.is-broken Label.DetailTaskTitle
{
	color: #e05a5a;
}

.DetailRuleList
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	margin-top: 4px;
}

.DetailRuleRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 2px;
}

.DetailRule
{
	width: fill-parent-flow( 1.0 );
	height: 20px;
	flow-children: right;
	padding-left: 6px;
	padding-right: 6px;
	background-color: #ffffff0a;
	border: 1px solid #ffffff10;
	border-radius: 2px;
}

.DetailRule.is-off
{
	visibility: collapse;
}

.DetailRuleRow .DetailRule
{
	margin-right: 3px;
}

.DetailRuleRow .DetailRule:last-child
{
	margin-right: 0px;
}

.DetailRule.is-empty
{
	background-color: #00000000;
	border: 1px solid #00000000;
}

Label.DetailRuleLabel
{
	width: 100%;
	height: 100%;
	font-size: 14;
	letter-spacing: 0.4px;
	color: #9aa2ac;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.MenuListTitle
{
	width: 100%;
	font-size: 15;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #e8eef4;
	text-align: center;
	text-overflow: ellipsis;
	white-space: nowrap;
	margin-bottom: 6px;
}

.MenuFilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 10px;
}

.MenuFilterBtn
{
	height: 26px;
	flow-children: none;
	padding-left: 10px;
	padding-right: 10px;
	margin-right: 6px;
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	border-radius: 3px;
	wash-color: none;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.MenuFilterBtn:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.MenuFilterBtn:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.MenuFilterBtn.active
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
}

.MenuFilterBtn.active:hover
{
	background-color: #f0a53144;
	border: 1px solid #f0a531;
}

.MenuFilterBtn.is-disabled
{
	opacity: 0.35;
	wash-color: #808080;
}

.MenuFilterBtn.is-disabled:hover
{
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	cursor: default;
}

.ScoreFilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 8px;
}

.ScoreFilterGroup
{
	width: fit-children;
	height: fit-children;
	flow-children: right;
}

.ScoreFilterSpacer
{
	width: fill-parent-flow( 1.0 );
	height: 1px;
}

.ScoreFilterGroup .MenuFilterBtn:last-child
{
	margin-right: 0px;
}

Label.MenuFilterLabel
{
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
	vertical-align: middle;
}

.MenuRows
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: squish scroll;
	padding-right: 12px;
}

.MenuRow
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 6px 8px 6px 8px;
	margin-bottom: 4px;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	wash-color: none;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.MenuRow:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.MenuRow:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.MenuRow.is-selected
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
}

.MenuRow.is-selected:hover
{
	background-color: #f0a53144;
	border: 1px solid #f0a531;
}

.MenuRow.is-off
{
	visibility: collapse;
}

.MenuRow.empty
{
	visibility: collapse;
}

.MenuRowHead
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	margin-bottom: 6px;
}

.MenuRow .ph-stat-lab
{
	height: 16px;
	margin-bottom: 4px;
}

.MenuRow Label.ph-stat-name
{
	font-size: 14;
	letter-spacing: 1.2px;
	color: #e8eef4;
}

.MenuRow Label.ph-stat-val
{
	width: 56px;
	font-size: 14;
	color: #f0a531;
}

.MenuRow Label.ph-stat-when
{
	width: 150px;
	font-size: 14;
	color: #9aa2ac;
}

.MenuRowSplit
{
	width: 100%;
	height: fit-children;
	flow-children: right;
}

.MenuTasksCol,
.MenuByCol
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: down;
	padding: 6px 8px 6px 8px;
	background-color: #0b0f14aa;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

.MenuTasksCol
{
	margin-right: 6px;
}

Label.MenuColHead
{
	width: 100%;
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #f0a531;
	margin-bottom: 4px;
}

.MenuTasks,
.MenuByList
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

.MenuTask
{
	width: 100%;
	height: 20px;
	flow-children: right;
	margin-bottom: 2px;
	padding-left: 5px;
	padding-right: 6px;
	background-color: #ffffff0a;
	border: 1px solid #ffffff10;
	border-radius: 2px;
}

.MenuTask.is-off
{
	visibility: collapse;
}

.MenuTask.is-done
{
	background-color: #9ccf4f18;
	border: 1px solid #9ccf4f44;
}

.MenuTask.is-broken
{
	background-color: #e05a5a22;
	border: 1px solid #e05a5a66;
}

.MenuTaskMark
{
	width: 3px;
	height: 12px;
	margin-right: 6px;
	vertical-align: middle;
	background-color: #f0a531;
	border-radius: 1px;
}

.MenuTask.is-done .MenuTaskMark
{
	background-color: #9ccf4f;
}

.MenuTask.is-broken .MenuTaskMark
{
	background-color: #e05a5a;
}

Label.MenuTaskLabel
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	font-size: 14;
	letter-spacing: 0.4px;
	color: #c5ccd4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.MenuTask.is-done Label.MenuTaskLabel
{
	color: #9ccf4f;
}

.MenuTask.is-broken Label.MenuTaskLabel
{
	color: #e05a5a;
}

.MenuByRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 2px;
}

.MenuBy
{
	width: fill-parent-flow( 1.0 );
	height: 20px;
	flow-children: right;
	padding-left: 6px;
	padding-right: 6px;
	background-color: #ffffff0a;
	border: 1px solid #ffffff10;
	border-radius: 2px;
}

.MenuBy.is-off
{
	visibility: collapse;
}

.MenuByRow .MenuBy
{
	margin-right: 3px;
}

.MenuByRow .MenuBy:last-child
{
	margin-right: 0px;
}

.MenuBy.is-empty
{
	background-color: #00000000;
	border: 1px solid #00000000;
}

.MenuBy.is-you
{
	background-color: #3d8f4522;
	border: 1px solid #3d8f45;
}

.MenuBy.is-you Label.MenuByLabel
{
	color: #6fdc78;
}

Label.MenuByLabel
{
	width: 100%;
	height: 100%;
	font-size: 14;
	color: #e8eef4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.MenuBy.is-empty Label.MenuByLabel
{
	color: #8b8f94;
}

.MenuEmpty
{
	width: 100%;
	font-size: 14;
	color: #8b8f94;
	text-align: center;
	margin-top: 12px;
}

.MenuEmpty.is-off
{
	visibility: collapse;
}

/* Hardcoded English credit in menu.xml — not a dialog variable. */
Label.MenuCredit
{
	width: 100%;
	height: fit-children;
	margin-top: 8px;
	padding-top: 8px;
	border-top: 1px solid #d9d9d90a;
	font-size: 14;
	color: #8b8f94;
	text-align: center;
	text-overflow: shrink;
}

/* prev | [pad] title… (page) [pad] | next — equal pads center the pair; title ellipsizes; page never shrinks. */
.ScoreTitleBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 6px;
	overflow: clip;
}

.ScoreTitleCenter
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: none;
	margin-left: 6px;
	margin-right: 6px;
	vertical-align: middle;
	overflow: clip;
}

.ScoreTitleCluster
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	vertical-align: middle;
	overflow: clip;
}

.ScoreTitlePad
{
	width: fill-parent-flow( 1.0 );
	height: 1px;
}

Label.ScoreTitle
{
	width: fill-parent-flow( 1.0 );
	font-size: 15;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #e8eef4;
	text-align: right;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
	margin-right: 6px;
}

Label.ScoreTitlePage
{
	width: fit-children;
	height: fit-children;
	font-size: 15;
	letter-spacing: 1.6px;
	color: #f0a531;
	text-align: center;
	vertical-align: middle;
	white-space: nowrap;
}

.MenuTitleNav
{
	width: 36px;
	height: 28px;
	flow-children: none;
	vertical-align: middle;
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	border-radius: 3px;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.MenuTitleNav:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.MenuTitleNav:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.MenuTitleNav.is-disabled,
.MenuTitleNav.is-disabled:hover
{
	opacity: 0.35;
	border: 1px solid #00000000;
	background-color: #ffffff0d;
	cursor: default;
	sound: "";
}

.ScoreSelfCard
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 12px 12px 12px 12px;
	margin-bottom: 10px;
	background-color: #f0a53118;
	border: 1px solid #f0a531;
	border-radius: 3px;
}

.ScoreSelfCard.empty
{
	visibility: collapse;
}

.ScoreSelfTop
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 10px;
}

Label.ScoreSelfRank
{
	width: 48px;
	font-size: 18;
	color: #f0a531;
	vertical-align: middle;
}

Label.ScoreSelfName
{
	width: fill-parent-flow( 1.0 );
	font-size: 15;
	color: #ffffff;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.ScoreSelfStats
{
	width: 100%;
	height: fit-children;
	flow-children: right;
}

.ScoreSelfStat
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: down;
	padding: 8px 10px 8px 10px;
	margin-right: 6px;
	background-color: #0b0f14aa;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

.ScoreSelfStat:last-child
{
	margin-right: 0px;
}

Label.ScoreSelfStatLabel
{
	width: 100%;
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #9aa2ac;
	margin-bottom: 4px;
}

Label.ScoreSelfStatVal
{
	width: 100%;
	font-size: 16;
	color: #f0a531;
}

.ScoreHeader
{
	width: 100%;
	height: 32px;
	flow-children: right;
	padding: 0px 10px 0px 10px;
	margin-bottom: 0px;
	background-color: #ffffff14;
	border-top: 1px solid #f0a53166;
	border-bottom: 1px solid #f0a53166;
}

Label.ScoreHead
{
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #9aa2ac;
	vertical-align: middle;
}

Label.ScoreHead.sort-active
{
	color: #f0a531;
}

.ScoreRows
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: squish scroll;
	border: 1px solid #ffffff14;
	border-top: 1px solid #00000000;
	background-color: #0b0f1488;
}

.ScoreRow
{
	width: 100%;
	height: 32px;
	flow-children: right;
	padding: 0px 10px 0px 10px;
	margin-bottom: 0px;
	background-color: #00000000;
	border: 1px solid #00000000;
	border-bottom: 1px solid #ffffff0a;
	border-radius: 0px;
	wash-color: none;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.ScoreRow.alt
{
	background-color: #ffffff08;
}

.ScoreRow.empty,
.ScoreRow.is-off
{
	visibility: collapse;
}

.ScoreRow:hover
{
	background-color: #ffffff14;
	border: 1px solid #f0a53166;
	border-bottom: 1px solid #f0a53166;
}

.ScoreRow:active
{
	background-color: #ffffff1e;
	border: 1px solid #f0a531;
	border-bottom: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.ScoreRow.is-self
{
	background-color: #f0a53122;
	border-bottom: 1px solid #f0a53144;
}

.ScoreRow.is-viewing
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
	border-bottom: 1px solid #f0a531;
}

.ScoreRow.is-viewing:hover
{
	background-color: #f0a53144;
	border: 1px solid #f0a531;
	border-bottom: 1px solid #f0a531;
}

Label.ScoreRank
{
	width: 36px;
	font-size: 14;
	color: #f0a531;
	vertical-align: middle;
}

Label.ScoreName
{
	width: fill-parent-flow( 1.0 );
	font-size: 14;
	color: #e8eef4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.ScoreCur
{
	width: 96px;
	font-size: 14;
	color: #f0a531;
	text-align: right;
	vertical-align: middle;
	margin-right: 10px;
}

Label.ScoreTot
{
	width: 72px;
	font-size: 14;
	color: #ffffff;
	text-align: right;
	vertical-align: middle;
}

.ScoreHeader Label.ScoreCur,
.ScoreHeader Label.ScoreTot
{
	font-size: 14;
	color: #9aa2ac;
}

.ScoreHeader Label.ScoreCur.sort-active,
.ScoreHeader Label.ScoreTot.sort-active
{
	color: #f0a531;
}

/* >>> hud_themes:begin */
/* Accent themes (gui.theme). Generated from tools/hud_themes.py — do not edit by hand. */
/* Gold is the baked-in default; other themes override accents. CT/T = stock CS2 colours. */

.theme-red .ph-bar { background-color: #e05a5a; }
.theme-red .ph-stat-fill { background-color: gradient( linear, 0% 0%, 100% 0%, from( #a83a3a ), to( #e05a5a ) ); }
.theme-red Label.ph-stat-val,
.theme-red Label.ScoreSelfRank,
.theme-red Label.ScoreSelfStatVal,
.theme-red Label.ScoreRank,
.theme-red .ScoreRow Label.ScoreCur,
.theme-red Label.ScoreTitlePage,
.theme-red Label.ScoreHead.sort-active
{ color: #e05a5a; }
.theme-red .MenuFilterBtn.active { background-color: #e05a5a22; border: 1px solid #e05a5a; }
.theme-red .MenuFilterBtn.active:hover { background-color: #e05a5a44; border: 1px solid #e05a5a; }
.theme-red .MenuFilterBtn:hover { border: 1px solid #e05a5a66; }
.theme-red .MenuFilterBtn:active { border: 1px solid #e05a5a; }
