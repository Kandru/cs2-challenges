/* ============================================================================
   Challenges HUD - one stylesheet for tracker.xml and menu.xml.
   Shared chrome comes from the Prophunt kit (workshop/example/hud.vcss).
   Hex colours only; no @define/var/rgba/display. Bars use clip ladders (p0 ... p100).
   Hide with ph-off (cards) / is-off (rows). Do not name a class "hidden".
   ============================================================================ */

/* Shared chrome */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.HudScreen.TrackerScreen
{
	z-index: 99998;
}

.ph-card
{
	opacity: 1;
	transform: translateY( 0px ) scale3d( 1, 1, 1 );
	brightness: 1;
	transition-property: opacity, transform, brightness;
	transition-duration: 1.0s;
	transition-timing-function: ease-out;
	overflow: noclip noclip;
	border-radius: 3px;
}

.ph-card.ph-fading
{
	opacity: 0;
}

/* Not "hidden" — that name exists on csgostyles and would collide. */
.ph-card.ph-off
{
	visibility: collapse;
	opacity: 0;
	transition-duration: 0s;
}

.ph-bg
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #12171ee8 ), to( #0b0f14f2 ) );
	background-image: url("s2r://panorama/images/backgrounds/bluedots_large_png.vtex");
	background-size: 360px 360px;
	background-repeat: repeat;
	background-img-opacity: 0.03;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	box-shadow: #000000c0 0px 8px 30px 0px;
	world-blur: gaussian( 2 );
	z-index: 0;
}

.ph-bar
{
	width: 3px;
	height: 100%;
	background-color: #f0a531;
	z-index: 5;
}

.ph-bar-left
{
	horizontal-align: left;
}

.ph-bar-right
{
	horizontal-align: right;
}

/* Fullscreen shell — 68px inset clears RoundStatus (4px + 60px + 4px gap).
   Content uses fill-parent-flow / fit-children; ph-bg uses ignore-parent-flow.
   PropGrid cannot use this (asymmetric 68/36 inset + flow children) — see spacers. */
.ph-fs
{
	width: 100%;
	height: 100%;
	padding-top: 68px;
	padding-right: 68px;
	padding-bottom: 68px;
	padding-left: 68px;
}

/* Shared title row — Prop/Sound/Weapon/Shop/Rules. */
.ph-titlebar
{
	width: 100%;
	height: 44px;
	flow-children: right;
	padding-left: 18px;
	padding-right: 18px;
	background-color: #ffffff14;
	border-bottom: 1px solid #d9d9d90a;
}

Label.ph-title
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 15;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #ffffff;
}

Label.ph-money
{
	vertical-align: middle;
	font-size: 14;
	letter-spacing: 1px;
	color: #9ccf4f;
}

/* Button label: parent must be flow-children:none. No height:100% — that
   pins the glyph to the top and makes vertical-align a no-op. */
Label.ph-btn-label
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
}

/* Shared title-bar icon buttons (close X, stop, maximize) + Prev/Next label. */
.ph-icon-btn
{
	width: 28px;
	height: 28px;
	flow-children: none;
	background-color: #ffffff0d;
	border: 0px solid transparent;
	border-radius: 3px;
	vertical-align: middle;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.ph-icon-btn:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.ph-icon-btn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.ph-close-x
{
	width: 12px;
	height: 2px;
	horizontal-align: center;
	vertical-align: middle;
	background-color: #ffffff;
	border-radius: 1px;
}

.ph-close-x-a
{
	transform: rotateZ( 45deg );
}

.ph-close-x-b
{
	transform: rotateZ( -45deg );
}

Label.ph-nav-label
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 14;
	color: #e8eef4;
}

.ph-stat
{
	width: 100%;
	flow-children: down;
}

.ph-stat.is-off
{
	visibility: collapse;
}

.ph-stat-lab
{
	width: 100%;
	height: 18px;
	flow-children: right;
	margin-bottom: 6px;
}

Label.ph-stat-name
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #e8eef4;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
}

Label.ph-stat-val
{
	width: 72px;
	height: 100%;
	font-size: 14;
	color: #f0a531;
	text-align: right;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
}

Label.ph-stat-when
{
	width: 150px;
	height: 100%;
	font-size: 14;
	color: #9aa2ac;
	text-align: right;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
	margin-right: 8px;
}

.ph-stat-track
{
	width: 100%;
	height: 7px;
	flow-children: none;
	border-radius: 4px;
	background-color: #ffffff12;
	overflow: clip;
}

.ph-stat-fill
{
	height: 100%;
	width: 100%;
	border-radius: 4px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( #f0a531 ), to( #ffd27a ) );
	transition-property: clip;
	transition-duration: 0.35s;
	clip: rect( 0%, 0%, 100%, 0% );
}

.ph-stat-fill.p100 { clip: rect( 0%, 100%, 100%, 0% ); }
.ph-stat-fill.p99 { clip: rect( 0%, 99%, 100%, 0% ); }
.ph-stat-fill.p98 { clip: rect( 0%, 98%, 100%, 0% ); }
.ph-stat-fill.p97 { clip: rect( 0%, 97%, 100%, 0% ); }
.ph-stat-fill.p96 { clip: rect( 0%, 96%, 100%, 0% ); }
.ph-stat-fill.p95 { clip: rect( 0%, 95%, 100%, 0% ); }
.ph-stat-fill.p94 { clip: rect( 0%, 94%, 100%, 0% ); }
.ph-stat-fill.p93 { clip: rect( 0%, 93%, 100%, 0% ); }
.ph-stat-fill.p92 { clip: rect( 0%, 92%, 100%, 0% ); }
.ph-stat-fill.p91 { clip: rect( 0%, 91%, 100%, 0% ); }
.ph-stat-fill.p90 { clip: rect( 0%, 90%, 100%, 0% ); }
.ph-stat-fill.p89 { clip: rect( 0%, 89%, 100%, 0% ); }
.ph-stat-fill.p88 { clip: rect( 0%, 88%, 100%, 0% ); }
.ph-stat-fill.p87 { clip: rect( 0%, 87%, 100%, 0% ); }
.ph-stat-fill.p86 { clip: rect( 0%, 86%, 100%, 0% ); }
.ph-stat-fill.p85 { clip: rect( 0%, 85%, 100%, 0% ); }
.ph-stat-fill.p84 { clip: rect( 0%, 84%, 100%, 0% ); }
.ph-stat-fill.p83 { clip: rect( 0%, 83%, 100%, 0% ); }
.ph-stat-fill.p82 { clip: rect( 0%, 82%, 100%, 0% ); }
.ph-stat-fill.p81 { clip: rect( 0%, 81%, 100%, 0% ); }
.ph-stat-fill.p80 { clip: rect( 0%, 80%, 100%, 0% ); }
.ph-stat-fill.p79 { clip: rect( 0%, 79%, 100%, 0% ); }
.ph-stat-fill.p78 { clip: rect( 0%, 78%, 100%, 0% ); }
.ph-stat-fill.p77 { clip: rect( 0%, 77%, 100%, 0% ); }
.ph-stat-fill.p76 { clip: rect( 0%, 76%, 100%, 0% ); }
.ph-stat-fill.p75 { clip: rect( 0%, 75%, 100%, 0% ); }
.ph-stat-fill.p74 { clip: rect( 0%, 74%, 100%, 0% ); }
.ph-stat-fill.p73 { clip: rect( 0%, 73%, 100%, 0% ); }
.ph-stat-fill.p72 { clip: rect( 0%, 72%, 100%, 0% ); }
.ph-stat-fill.p71 { clip: rect( 0%, 71%, 100%, 0% ); }
.ph-stat-fill.p70 { clip: rect( 0%, 70%, 100%, 0% ); }
.ph-stat-fill.p69 { clip: rect( 0%, 69%, 100%, 0% ); }
.ph-stat-fill.p68 { clip: rect( 0%, 68%, 100%, 0% ); }
.ph-stat-fill.p67 { clip: rect( 0%, 67%, 100%, 0% ); }
