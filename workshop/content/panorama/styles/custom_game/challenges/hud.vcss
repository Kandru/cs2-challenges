.ph-stat-fill.p65 { clip: rect( 0%, 65%, 100%, 0% ); }
.ph-stat-fill.p64 { clip: rect( 0%, 64%, 100%, 0% ); }
.ph-stat-fill.p63 { clip: rect( 0%, 63%, 100%, 0% ); }
.ph-stat-fill.p62 { clip: rect( 0%, 62%, 100%, 0% ); }
.ph-stat-fill.p61 { clip: rect( 0%, 61%, 100%, 0% ); }
.ph-stat-fill.p60 { clip: rect( 0%, 60%, 100%, 0% ); }
.ph-stat-fill.p59 { clip: rect( 0%, 59%, 100%, 0% ); }
.ph-stat-fill.p58 { clip: rect( 0%, 58%, 100%, 0% ); }
