/* ============================================================================
   Challenges HUD - one stylesheet for tracker.xml and menu.xml.
   Shared chrome comes from the Prophunt kit (workshop/example/hud.vcss).
   Hex colours only; no @define/var/rgba/display. Bars use clip ladders (p0 ... p100).
   Hide with ph-off (cards) / is-off (rows). Do not name a class "hidden".
   ============================================================================ */

/* Shared chrome */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.ph-card
{
	opacity: 1;
	transform: translateY( 0px ) scale3d( 1, 1, 1 );
	brightness: 1;
	transition-property: opacity, transform, brightness;
	transition-duration: 1.0s;
	transition-timing-function: ease-out;
	overflow: noclip noclip;
	border-radius: 3px;
}

.ph-card.ph-fading
{
	opacity: 0;
}

/* Not "hidden" — that name exists on csgostyles and would collide. */
.ph-card.ph-off
{
	visibility: collapse;
	opacity: 0;
	transition-duration: 0s;
}

.ph-bg
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #12171ee8 ), to( #0b0f14f2 ) );
	background-image: url("s2r://panorama/images/backgrounds/bluedots_large_png.vtex");
	background-size: 360px 360px;
	background-repeat: repeat;
	background-img-opacity: 0.03;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	box-shadow: #000000c0 0px 8px 30px 0px;
	world-blur: gaussian( 2 );
	z-index: 0;
}

.ph-bar
{
	width: 3px;
	height: 100%;
	background-color: #f0a531;
	z-index: 5;
}

.ph-bar-left
{
	horizontal-align: left;
}

.ph-bar-right
{
	horizontal-align: right;
}

/* Fullscreen shell — 68px inset clears RoundStatus (4px + 60px + 4px gap).
   Content uses fill-parent-flow / fit-children; ph-bg uses ignore-parent-flow.
   PropGrid cannot use this (asymmetric 68/36 inset + flow children) — see spacers. */
.ph-fs
{
	width: 100%;
	height: 100%;
	padding-top: 68px;
	padding-right: 68px;
	padding-bottom: 68px;
	padding-left: 68px;
}

/* Shared title row — Prop/Sound/Weapon/Shop/Rules. */
.ph-titlebar
{
	width: 100%;
	height: 44px;
	flow-children: right;
	padding-left: 18px;
	padding-right: 18px;
	background-color: #ffffff14;
	border-bottom: 1px solid #d9d9d90a;
}

Label.ph-title
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 15;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #ffffff;
}

Label.ph-money
{
	vertical-align: middle;
	font-size: 14;
	letter-spacing: 1px;
	color: #9ccf4f;
}

/* Button label: parent must be flow-children:none. No height:100% — that
   pins the glyph to the top and makes vertical-align a no-op. */
Label.ph-btn-label
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
}

/* Shared title-bar icon buttons (close X, stop, maximize) + Prev/Next label. */
.ph-icon-btn
{
	width: 28px;
	height: 28px;
	flow-children: none;
	background-color: #ffffff0d;
	border: 0px solid transparent;
	border-radius: 3px;
	vertical-align: middle;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.ph-icon-btn:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.ph-icon-btn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.ph-close-x
{
	width: 12px;
	height: 2px;
	horizontal-align: center;
	vertical-align: middle;
	background-color: #ffffff;
	border-radius: 1px;
}

.ph-close-x-a
{
	transform: rotateZ( 45deg );
}

.ph-close-x-b
{
	transform: rotateZ( -45deg );
}

Label.ph-nav-label
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 14;
	color: #e8eef4;
}

.ph-stat
{
	width: 100%;
	flow-children: down;
}

.ph-stat.is-off
{
	visibility: collapse;
}

.ph-stat-lab
{
	width: 100%;
	height: 18px;
	flow-children: right;
	margin-bottom: 6px;
}

Label.ph-stat-name
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #e8eef4;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
}

Label.ph-stat-val
{
	width: 72px;
	height: 100%;
	font-size: 14;
	color: #f0a531;
	text-align: right;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
}

Label.ph-stat-when
{
	width: 150px;
	height: 100%;
	font-size: 14;
	color: #9aa2ac;
	text-align: right;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
	margin-right: 8px;
}

.ph-stat-track
{
	width: 100%;
	height: 7px;
	flow-children: none;
	border-radius: 4px;
	background-color: #ffffff12;
	overflow: clip;
}

.ph-stat-fill
{
	height: 100%;
	width: 100%;
	border-radius: 4px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( #f0a531 ), to( #ffd27a ) );
	transition-property: clip;
	transition-duration: 0.35s;
	clip: rect( 0%, 0%, 100%, 0% );
}

.ph-stat-fill.p100 { clip: rect( 0%, 100%, 100%, 0% ); }
.ph-stat-fill.p90 { clip: rect( 0%, 90%, 100%, 0% ); }
.ph-stat-fill.p80 { clip: rect( 0%, 80%, 100%, 0% ); }
.ph-stat-fill.p70 { clip: rect( 0%, 70%, 100%, 0% ); }
.ph-stat-fill.p60 { clip: rect( 0%, 60%, 100%, 0% ); }
.ph-stat-fill.p50 { clip: rect( 0%, 50%, 100%, 0% ); }
.ph-stat-fill.p40 { clip: rect( 0%, 40%, 100%, 0% ); }
.ph-stat-fill.p30 { clip: rect( 0%, 30%, 100%, 0% ); }
.ph-stat-fill.p20 { clip: rect( 0%, 20%, 100%, 0% ); }
.ph-stat-fill.p10 { clip: rect( 0%, 10%, 100%, 0% ); }
.ph-stat-fill.p0 { clip: rect( 0%, 0%, 100%, 0% ); }

/* ============================================================================
   Tracker - top-right card; tasks only (no completers).
   ============================================================================ */

.Tracker
{
	width: 420px;
	horizontal-align: right;
	vertical-align: top;
	margin-top: 10px;
	margin-right: 10px;
	z-index: 100;
}

.TrackerContent
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	overflow: noclip noclip;
	z-index: 2;
}

.TrackerBody
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 8px 12px 6px 14px;
}

.TrackerTimer
{
	width: 100%;
	margin-left: 14px;
	margin-right: 12px;
	margin-bottom: 8px;
}

.TrackerTimer.is-off
{
	visibility: collapse;
}

.TrackerRow
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 8px 8px 8px 8px;
	margin-bottom: 6px;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

.TrackerRow.is-off
{
	visibility: collapse;
}

Label.TrackerCount
{
	margin-left: 10px;
}

.TrackerRow .ph-stat-lab
{
	height: 16px;
	margin-bottom: 4px;
}

.TrackerRow Label.ph-stat-name
{
	font-size: 14;
	letter-spacing: 1.2px;
	color: #e8eef4;
}

.TrackerRow Label.ph-stat-val
{
	width: 52px;
	font-size: 14;
	color: #f0a531;
}

.TrackerRow .MenuRowHead
{
	margin-bottom: 6px;
}

.TrackerRowSplit
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

.TrackerRow .MenuTasksCol,
.TrackerRow .MenuByCol
{
	width: 100%;
	margin-right: 0px;
	margin-bottom: 4px;
	padding: 6px 8px 6px 8px;
}

.TrackerRow .MenuByCol
{
	margin-bottom: 0px;
}

/* ============================================================================
   Menu - fullscreen frame (.ph-fs), list 2/3 + scoreboard 1/3.
   Challenge cards: compact header + 50/50 tasks|completers (2-col names).
   4 cards/page; list does not scroll. Footers pin via MenuListSpacer.
   ============================================================================ */

.MenuRoot
{
	z-index: 300;
}

.MenuContent
{
	width: 100%;
	height: 100%;
	flow-children: down;
	z-index: 2;
}

.MenuRoot .ph-titlebar
{
	padding-right: 12px;
}

.MenuBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-left: 18px;
	padding-right: 18px;
	padding-top: 12px;
	padding-bottom: 12px;
}

/* Definite height under a down parent so list/score can use height:100% in a right row. */
.MenuColumns
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.MenuList
{
	width: fill-parent-flow( 2.0 );
	height: 100%;
	flow-children: down;
	margin-right: 18px;
}

.MenuScore
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
}

.MenuFilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 10px;
}

.MenuFilterBtn
{
	height: 26px;
	flow-children: none;
	padding-left: 10px;
	padding-right: 10px;
	margin-right: 6px;
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	border-radius: 3px;
	wash-color: none;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.MenuFilterBtn:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.MenuFilterBtn:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.MenuFilterBtn.active
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
}

.MenuFilterBtn.active:hover
{
	background-color: #f0a53144;
	border: 1px solid #f0a531;
}

.MenuFilterBtn.is-disabled,
.MenuFooterBtn.is-disabled
{
	opacity: 0.35;
	wash-color: #808080;
}

.MenuFilterBtn.is-disabled:hover,
.MenuFooterBtn.is-disabled:hover
{
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	cursor: default;
}

.ScoreFilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 8px;
}

.ScoreFilterGroup
{
	width: fit-children;
	height: fit-children;
	flow-children: right;
}

.ScoreFilterSpacer
{
	width: fill-parent-flow( 1.0 );
	height: 1px;
}

.ScoreFilterGroup .MenuFilterBtn:last-child
{
	margin-right: 0px;
}

Label.MenuFilterLabel
{
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
	vertical-align: middle;
}

.MenuRows
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	overflow: clip;
}

.MenuListSpacer
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
}

.MenuRow
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 6px 8px 6px 8px;
	margin-bottom: 4px;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

.MenuRow.is-off
{
	visibility: collapse;
}

.MenuRow.empty
{
	visibility: collapse;
}

.MenuRowHead
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	margin-bottom: 6px;
}

.MenuRow .ph-stat-lab
{
	height: 16px;
	margin-bottom: 4px;
}

.MenuRow Label.ph-stat-name
{
	font-size: 14;
	letter-spacing: 1.2px;
	color: #e8eef4;
}

.MenuRow Label.ph-stat-val
{
	width: 56px;
	font-size: 14;
	color: #f0a531;
}

.MenuRow Label.ph-stat-when
{
	width: 150px;
	font-size: 14;
	color: #9aa2ac;
}

.MenuRowSplit
{
	width: 100%;
	height: fit-children;
	flow-children: right;
}

.MenuTasksCol,
.MenuByCol
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: down;
	padding: 6px 8px 6px 8px;
	background-color: #0b0f14aa;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

.MenuTasksCol
{
	margin-right: 6px;
}

Label.MenuColHead
{
	width: 100%;
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #f0a531;
	margin-bottom: 4px;
}

.MenuTasks,
.MenuByList
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

.MenuTask
{
	width: 100%;
	height: 20px;
	flow-children: right;
	margin-bottom: 2px;
	padding-left: 5px;
	padding-right: 6px;
	background-color: #ffffff0a;
	border: 1px solid #ffffff10;
	border-radius: 2px;
}

.MenuTask.is-off
{
	visibility: collapse;
}

.MenuTask.is-done
{
	background-color: #9ccf4f18;
	border: 1px solid #9ccf4f44;
}

.MenuTask.is-broken
{
	background-color: #e05a5a22;
	border: 1px solid #e05a5a66;
}

.MenuTaskMark
{
	width: 3px;
	height: 12px;
	margin-right: 6px;
	vertical-align: middle;
	background-color: #f0a531;
	border-radius: 1px;
}

.MenuTask.is-done .MenuTaskMark
{
	background-color: #9ccf4f;
}

.MenuTask.is-broken .MenuTaskMark
{
	background-color: #e05a5a;
}

Label.MenuTaskLabel
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	font-size: 14;
	letter-spacing: 0.4px;
	color: #c5ccd4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.MenuTask.is-done Label.MenuTaskLabel
{
	color: #9ccf4f;
}

.MenuTask.is-broken Label.MenuTaskLabel
{
	color: #e05a5a;
}

.MenuByRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 2px;
}

.MenuBy
{
	width: fill-parent-flow( 1.0 );
	height: 20px;
	flow-children: right;
	padding-left: 6px;
	padding-right: 6px;
	background-color: #ffffff0a;
	border: 1px solid #ffffff10;
	border-radius: 2px;
}

.MenuBy.is-off
{
	visibility: collapse;
}

.MenuByRow .MenuBy
{
	margin-right: 3px;
}

.MenuByRow .MenuBy:last-child
{
	margin-right: 0px;
}

.MenuBy.is-empty
{
	background-color: #00000000;
	border: 1px solid #00000000;
}

.MenuBy.is-you
{
	background-color: #3d8f4522;
	border: 1px solid #3d8f45;
}

.MenuBy.is-you Label.MenuByLabel
{
	color: #6fdc78;
}

Label.MenuByLabel
{
	width: 100%;
	height: 100%;
	font-size: 14;
	color: #e8eef4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.MenuBy.is-empty Label.MenuByLabel
{
	color: #8b8f94;
}

.MenuEmpty
{
	width: 100%;
	font-size: 14;
	color: #8b8f94;
	text-align: center;
	margin-top: 12px;
}

.MenuFooter
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-top: 6px;
	padding-top: 8px;
	border-top: 1px solid #d9d9d90a;
}

.MenuFooterBtn
{
	width: fill-parent-flow( 1.0 );
	height: 28px;
	flow-children: none;
	margin: 0px 2px;
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.MenuFooterBtn:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.MenuFooterBtn:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

Label.MenuPage
{
	width: fill-parent-flow( 1.4 );
	height: 28px;
	font-size: 14;
	color: #f0a531;
	text-align: center;
	vertical-align: middle;
}

.ScoreTitleBar
{
	width: 100%;
	height: fit-children;
	flow-children: none;
	margin-bottom: 8px;
	padding-top: 4px;
	padding-bottom: 4px;
}

Label.ScoreTitle
{
	width: 100%;
	font-size: 15;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #e8eef4;
	text-align: center;
}

.ScoreSelfCard
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 12px 12px 12px 12px;
	margin-bottom: 10px;
	background-color: #f0a53118;
	border: 1px solid #f0a531;
	border-radius: 3px;
}

.ScoreSelfCard.empty
{
	visibility: collapse;
}

.ScoreSelfTop
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	margin-bottom: 10px;
}

Label.ScoreSelfRank
{
	width: 48px;
	font-size: 18;
	color: #f0a531;
	vertical-align: middle;
}

Label.ScoreSelfName
{
	width: fill-parent-flow( 1.0 );
	font-size: 15;
	color: #ffffff;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.ScoreSelfStats
{
	width: 100%;
	height: fit-children;
	flow-children: right;
}

.ScoreSelfStat
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: down;
	padding: 8px 10px 8px 10px;
	margin-right: 6px;
	background-color: #0b0f14aa;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

.ScoreSelfStat:last-child
{
	margin-right: 0px;
}

Label.ScoreSelfStatLabel
{
	width: 100%;
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #9aa2ac;
	margin-bottom: 4px;
}

Label.ScoreSelfStatVal
{
	width: 100%;
	font-size: 16;
	color: #f0a531;
}

.ScoreHeader
{
	width: 100%;
	height: 32px;
	flow-children: right;
	padding: 0px 10px 0px 10px;
	margin-bottom: 0px;
	background-color: #ffffff14;
	border-top: 1px solid #f0a53166;
	border-bottom: 1px solid #f0a53166;
}

Label.ScoreHead
{
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #9aa2ac;
	vertical-align: middle;
}

Label.ScoreHead.sort-active
{
	color: #f0a531;
}

.ScoreRows
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: squish scroll;
	border: 1px solid #ffffff14;
	border-top: 1px solid #00000000;
	background-color: #0b0f1488;
}

.ScoreRow
{
	width: 100%;
	height: 32px;
	flow-children: right;
	padding: 0px 10px 0px 10px;
	margin-bottom: 0px;
	background-color: #00000000;
	border: 1px solid #00000000;
	border-bottom: 1px solid #ffffff0a;
	border-radius: 0px;
}

.ScoreRow.alt
{
	background-color: #ffffff08;
}

.ScoreRow.empty,
.ScoreRow.is-off
{
	visibility: collapse;
}

.ScoreRow.is-self
{
	background-color: #f0a53122;
	border-bottom: 1px solid #f0a53144;
}

Label.ScoreRank
{
	width: 36px;
	font-size: 14;
	color: #f0a531;
	vertical-align: middle;
}

Label.ScoreName
{
	width: fill-parent-flow( 1.0 );
	font-size: 14;
	color: #e8eef4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

Label.ScoreCur
{
	width: 96px;
	font-size: 14;
	color: #f0a531;
	text-align: right;
	vertical-align: middle;
	margin-right: 10px;
}

Label.ScoreTot
{
	width: 72px;
	font-size: 14;
	color: #ffffff;
	text-align: right;
	vertical-align: middle;
}

.ScoreHeader Label.ScoreCur,
.ScoreHeader Label.ScoreTot
{
	font-size: 14;
	color: #9aa2ac;
}

.ScoreHeader Label.ScoreCur.sort-active,
.ScoreHeader Label.ScoreTot.sort-active
{
	color: #f0a531;
}

/* ============================================================================
   Accent themes (gui.theme). Gold is the default accent (#f0a531).
   CT / T use stock CS2 team colours (#96c8fa / #eabe54).
   ============================================================================ */

.theme-gold .ph-bar { background-color: #f0a531; }
.theme-gold .ph-stat-fill { background-color: gradient( linear, 0% 0%, 100% 0%, from( #f0a531 ), to( #ffd27a ) ); }

.theme-ct .ph-bar { background-color: #96c8fa; }
.theme-ct .ph-stat-fill { background-color: gradient( linear, 0% 0%, 100% 0%, from( #5a9fd4 ), to( #96c8fa ) ); }
.theme-ct Label.ph-stat-val,
.theme-ct Label.ScoreSelfRank,
.theme-ct Label.ScoreSelfStatVal,
.theme-ct Label.ScoreRank,
.theme-ct Label.ScoreCur,
.theme-ct Label.MenuPage,
.theme-ct Label.ScoreHead.sort-active,
.theme-ct .ScoreHeader Label.ScoreCur.sort-active,
