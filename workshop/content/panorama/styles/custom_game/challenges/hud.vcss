.theme-silver Label.ScoreSelfStatVal,
.theme-silver Label.ScoreRank,
.theme-silver .ScoreRow Label.ScoreCur,
.theme-silver Label.ScoreTitlePage,
.theme-silver Label.ScoreHead.sort-active
{ color: #c9d2dc; }
.theme-silver .MenuFilterBtn.active { background-color: #c9d2dc22; border: 1px solid #c9d2dc; }
.theme-silver .MenuFilterBtn.active:hover { background-color: #c9d2dc44; border: 1px solid #c9d2dc; }
.theme-silver .MenuFilterBtn:hover { border: 1px solid #c9d2dc66; }
.theme-silver .MenuFilterBtn:active { border: 1px solid #c9d2dc; }
.theme-silver .MenuTitleNav:hover { border: 1px solid #c9d2dc66; }
.theme-silver .MenuTitleNav:active { border: 1px solid #c9d2dc; }
.theme-silver .MenuRow:hover { border: 1px solid #c9d2dc66; }
.theme-silver .MenuRow:active { border: 1px solid #c9d2dc; }
.theme-silver .MenuRow.is-selected { background-color: #c9d2dc22; border: 1px solid #c9d2dc; }
.theme-silver .MenuRow.is-selected:hover { background-color: #c9d2dc44; border: 1px solid #c9d2dc; }
.theme-silver .ScoreSelfCard { background-color: #c9d2dc18; border: 1px solid #c9d2dc; }
.theme-silver .ScoreRow:hover { border: 1px solid #c9d2dc66; border-bottom: 1px solid #c9d2dc66; }
.theme-silver .ScoreRow:active { border: 1px solid #c9d2dc; border-bottom: 1px solid #c9d2dc; }
.theme-silver .ScoreRow.is-self { background-color: #c9d2dc22; border-bottom: 1px solid #c9d2dc44; }
.theme-silver .ScoreRow.is-viewing { background-color: #c9d2dc22; border: 1px solid #c9d2dc; border-bottom: 1px solid #c9d2dc; }
.theme-silver .ScoreRow.is-viewing:hover { background-color: #c9d2dc44; border: 1px solid #c9d2dc; border-bottom: 1px solid #c9d2dc; }
.theme-silver .ScoreHeader { border-top: 1px solid #c9d2dc66; border-bottom: 1px solid #c9d2dc66; }
.theme-silver .MenuTask.is-done .MenuTaskMark { background-color: #c9d2dc; }

/* <<< hud_themes:end */
