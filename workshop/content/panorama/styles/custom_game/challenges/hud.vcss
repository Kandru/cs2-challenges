.ph-stat-fill.p47 { clip: rect( 0%, 47%, 100%, 0% ); }
.ph-stat-fill.p46 { clip: rect( 0%, 46%, 100%, 0% ); }
.ph-stat-fill.p45 { clip: rect( 0%, 45%, 100%, 0% ); }
.ph-stat-fill.p44 { clip: rect( 0%, 44%, 100%, 0% ); }
.ph-stat-fill.p43 { clip: rect( 0%, 43%, 100%, 0% ); }
