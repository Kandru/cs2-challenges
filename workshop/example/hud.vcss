/* Fullscreen shop. Shell padding via .ph-fs. Above weapon menu. */

.ShopMenu
{
	z-index: 300;
}

.ShopMenuContent
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

/* Close sits after money — tighter right padding than shared .ph-titlebar. */
.ShopMenu .ph-titlebar
{
	padding-right: 12px;
}

.ShopMenu Label.ph-money
{
	margin-right: 10px;
}

.ShopFilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	padding-left: 18px;
	padding-right: 18px;
	padding-top: 8px;
	padding-bottom: 2px;
}

.ShopFilterBtn
{
	height: 26px;
	flow-children: none;
	padding-left: 10px;
	padding-right: 10px;
	margin-right: 6px;
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	border-radius: 3px;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.ShopFilterBtn:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.ShopFilterBtn:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.ShopFilterBtn.is-on
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
}

.ShopFilterBtn.is-on:hover
{
	background-color: #f0a53144;
	border: 1px solid #f0a531;
}

.ShopFilterBtn.is-disabled
{
	opacity: 0.35;
	saturation: 0.15;
}

.ShopFilterBtn.is-disabled:hover,
.ShopFilterBtn.is-disabled:active
{
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	cursor: default;
	sound: none;
}

.ShopFilterBtn.is-empty
{
	visibility: collapse;
	width: 0px;
	padding-left: 0px;
	padding-right: 0px;
	margin-right: 0px;
}

Label.ShopFilterLabel
{
	/* Fit-children button — no ph-btn-label (width:100% needs a sized parent). */
	font-size: 11.55;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
	vertical-align: middle;
}

.ShopGrid
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-left: 18px;
	padding-right: 18px;
	padding-top: 10px;
	padding-bottom: 4px;
}

.ShopFooter
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	padding-left: 18px;
	padding-right: 18px;
	padding-top: 6px;
	padding-bottom: 10px;
	border-top: 1px solid #d9d9d90a;
}

.ShopFooterBtn
{
	width: fill-parent-flow( 1.0 );
	flow-children: none;
	padding: 6px 4px;
	margin: 0px 2px;
	background-color: #ffffff0d;
	border-radius: 3px;
	border: 1px solid #00000000;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.ShopFooterBtn:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.ShopFooterBtn:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.ShopFooterBtn.is-disabled
{
	opacity: 0.35;
	saturation: 0.15;
}

.ShopFooterBtn.is-disabled:hover,
.ShopFooterBtn.is-disabled:active
{
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	cursor: default;
	sound: none;
}

Label.ShopPage
{
	width: 72px;
	vertical-align: middle;
	horizontal-align: center;
	text-align: center;
	font-size: 12.6;
	letter-spacing: 1px;
	color: #d5dde6;
	white-space: nowrap;
}

.ShopRow
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
}

/* 6px gap between rows (margin on fill-parent-flow rows is squished). */
.ShopRowGap
{
	width: 100%;
	height: 6px;
}

.ShopRowFlow
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.ShopCard
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	background-color: #ffffff0d;
	border-radius: 3px;
	padding-top: 8px;
	padding-bottom: 8px;
	padding-left: 0px;
	padding-right: 0px;
	margin-right: 6px;
	border: 1px solid transparent;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.ShopCard:last-child
{
	margin-right: 0px;
}

.ShopCard.is-selected
{
	border: 1px solid #f0a531;
	background-color: #f0a53122;
}

.ShopCard.is-broke
{
	opacity: 0.45;
}

/* Keep the slot (four columns); hide chrome only. */
.ShopCard.is-empty
{
	background-color: #060a1073;
	border: 1px dashed #6e7d8c47;
	opacity: 0.45;
}

.ShopCard.is-empty .ShopCardHead,
.ShopCard.is-empty Label.ShopCardSub,
.ShopCard.is-empty .ShopCardImg,
.ShopCard.is-empty .ShopBuyBtn
{
	visibility: collapse;
}

.ShopCardHead
{
	width: 100%;
	height: fit-children;
	min-height: 16px;
	flow-children: right;
	padding-left: 6px;
	padding-right: 6px;
	margin-bottom: 4px;
}

Label.ShopCardTitle
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 12.6;
	letter-spacing: 1px;
	text-transform: uppercase;
	text-align: left;
	color: #e8eef4;
	white-space: nowrap;
	text-overflow: ellipsis;
}

Label.ShopCardMeta
{
	vertical-align: middle;
	font-size: 10.5;
	letter-spacing: 1px;
	color: #9ccf4f;
	text-align: right;
	white-space: nowrap;
}

Label.ShopCardSub
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	font-size: 11.55;
	color: #d5dde6;
	padding-left: 6px;
	padding-right: 6px;
	white-space: normal;
	text-overflow: ellipsis;
}

/* With an image the subtitle stays compact; the thumb fills the rest above Buy. */
.ShopCard.has-image Label.ShopCardSub
{
	height: fit-children;
}

.ShopCardImg
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	margin-top: 4px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	background-size: 100% 100%;
	overflow: clip;
}

.ShopCardImg.is-off
{
	visibility: collapse;
	height: 0px;
	margin-top: 0px;
}

/* Default = no art. Add .ph-shop-img-{key} rules when shipping thumbs under
   panorama/images/custom_game/prophunt/shop/{key}.vtex */
.ph-shop-img-default
{
	background-image: none;
}

.ShopBuyBtn,
.ShopBuyBtn:hover,
.ShopBuyBtn:active
{
	wash-color: none;
}

.ShopBuyBtn
{
	width: 100%;
	height: 28px;
	flow-children: none;
	margin-left: 6px;
	margin-right: 6px;
	margin-top: 6px;
	background-color: #f0a53122;
	border: 1px solid #f0a531;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.ShopBuyBtn:hover
{
	background-color: #f0a53144;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.ShopBuyBtn:active
{
	background-color: #f0a53166;
	sound: "UIPanorama.generic_button_press";
}

.ShopBuyBtn.is-broke,
.ShopBuyBtn.is-disabled
{
	opacity: 0.35;
	saturation: 0.15;
}

.ShopBuyBtn.is-empty
{
	visibility: collapse;
	height: 0px;
	margin-top: 0px;
}

Label.ShopBuyLabel
{
	font-size: 12.6;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
}

/* Fullscreen server rules. Shell padding via .ph-fs. Above shop. */

.RulesMenu
{
	z-index: 400;
}

.RulesMenuContent
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

.RulesBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	padding-left: 18px;
	padding-right: 18px;
	padding-top: 12px;
	padding-bottom: 8px;
}

.RulesScroll
{
	width: 100%;
	height: 100%;
	flow-children: down;
	overflow: squish scroll;
}

.RulesLine
{
	width: 100%;
	margin-bottom: 6px;
}

.RulesLine.is-off
{
	visibility: collapse;
}

.RulesLine.is-blank
{
	height: 20px;
}

Label.RulesLineText
{
	width: 100%;
	font-size: 15;
	color: #e8eef4;
	white-space: normal;
}

.RulesFooter
{
	width: 100%;
	height: 56px;
	flow-children: right;
	padding-left: 18px;
	padding-right: 18px;
	padding-bottom: 10px;
	border-top: 1px solid #d9d9d90a;
}

.RulesAgreeBtn,
.RulesAgreeBtn:hover,
.RulesAgreeBtn:active,
.RulesDenyBtn,
.RulesDenyBtn:hover,
.RulesDenyBtn:active
{
	wash-color: none;
}

.RulesAgreeBtn
{
	width: fill-parent-flow( 1.0 );
	height: 40px;
	flow-children: none;
	vertical-align: middle;
	margin-right: 8px;
	background-color: #9ccf4f33;
	border: 1px solid #9ccf4f;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.RulesAgreeBtn:hover
{
	background-color: #9ccf4f55;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.RulesAgreeBtn:active
{
	background-color: #9ccf4f77;
	sound: "UIPanorama.generic_button_press";
}

Label.RulesAgreeLabel
{
	font-size: 18;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #9ccf4f;
}

.RulesDenyBtn
{
	width: fill-parent-flow( 1.0 );
	height: 40px;
	flow-children: none;
	vertical-align: middle;
	margin-left: 8px;
	background-color: #ff6b6b22;
	border: 1px solid #ff6b6baa;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.RulesDenyBtn:hover
{
	background-color: #ff6b6b44;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.RulesDenyBtn:active
{
	background-color: #ff6b6b66;
	sound: "UIPanorama.generic_button_press";
}

Label.RulesDenyLabel
{
	font-size: 18;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #ff9a9aff;
	overflow: squish;
	text-overflow: shrink;
}

