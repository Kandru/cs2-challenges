/* ============================================================================
   Prophunt HUD — one stylesheet for every custom_hud_layout.
   CS2-like skin (gold accent, near-black panels) inspired by hudkit.vcss,
   written with values this client accepts. Hex only; no @define/var/rgba/display.
   Bars use clip ladders (p0…p100), not width. Hide with ph-off / is-off.
   ============================================================================ */

/* Shared chrome */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.ph-card
{
	opacity: 1;
	transform: translateY( 0px ) scale3d( 1, 1, 1 );
	brightness: 1;
	transition-property: opacity, transform, brightness;
	transition-duration: 0.22s;
	transition-timing-function: ease-out;
	overflow: noclip noclip;
	border-radius: 3px;
}

/* Not "hidden" — that name exists on csgostyles and would collide. */
.ph-card.ph-off
{
	visibility: collapse;
	opacity: 0;
}

.ph-bg
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #12171ee8 ), to( #0b0f14f2 ) );
	background-image: url("s2r://panorama/images/backgrounds/bluedots_large_png.vtex");
	background-size: 360px 360px;
	background-repeat: repeat;
	background-img-opacity: 0.03;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	box-shadow: #000000c0 0px 8px 30px 0px;
	world-blur: gaussian( 2 );
	z-index: 0;
}

.ph-bar
{
	width: 3px;
	height: 100%;
	background-color: #f0a531;
	z-index: 5;
}

.ph-bar-left
{
	horizontal-align: left;
}

.ph-bar-right
{
	horizontal-align: right;
}

/* Fullscreen shell — 68px inset clears RoundStatus (4px + 60px + 4px gap).
   Content uses fill-parent-flow / fit-children; ph-bg uses ignore-parent-flow.
   PropGrid cannot use this (asymmetric 68/36 inset + flow children) — see spacers. */
.ph-fs
{
	width: 100%;
	height: 100%;
	padding-top: 68px;
	padding-right: 68px;
	padding-bottom: 68px;
	padding-left: 68px;
}

/* Shared title row — Prop/Sound/Weapon/Shop/Rules. */
.ph-titlebar
{
	width: 100%;
	height: 44px;
	flow-children: right;
	padding-left: 18px;
	padding-right: 18px;
	background-color: #ffffff14;
	border-bottom: 1px solid #d9d9d90a;
}

Label.ph-title
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 15;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #ffffff;
}

Label.ph-money
{
	vertical-align: middle;
	font-size: 14;
	letter-spacing: 1px;
	color: #9ccf4f;
}

/* Button label: parent must be flow-children:none. No height:100% — that
   pins the glyph to the top and makes vertical-align a no-op. */
Label.ph-btn-label
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
}

/* Shared title-bar icon buttons (close X, stop, maximize) + Prev/Next label. */
.ph-icon-btn
{
	width: 28px;
	height: 28px;
	flow-children: none;
	background-color: #ffffff0d;
	border: 0px solid transparent;
	border-radius: 3px;
	vertical-align: middle;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.ph-icon-btn:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.ph-icon-btn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.ph-close-x
{
	width: 12px;
	height: 2px;
	horizontal-align: center;
	vertical-align: middle;
	background-color: #ffffff;
	border-radius: 1px;
}

.ph-close-x-a
{
	transform: rotateZ( 45deg );
}

.ph-close-x-b
{
	transform: rotateZ( -45deg );
}

Label.ph-nav-label
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 13;
	color: #e8eef4;
}

/* Status bar — kit label + gold clip fill (sound cooldown / random-sound wait). */
.ph-stat
{
	width: 100%;
	flow-children: down;
}

.ph-stat.is-off
{
	visibility: collapse;
}

.PlayerInfoBody .ph-stat
{
	margin-top: 2px;
}

.PlayerInfoBody .ph-stat-lab
{
	height: 12px;
	margin-bottom: 3px;
}

.PlayerInfoBody Label.ph-stat-name,
.PlayerInfoBody Label.ph-stat-val
{
	font-size: 10;
}

.SoundBody .ph-stat
{
	margin-bottom: 6px;
}

.ph-stat-lab
{
	width: 100%;
	height: 14px;
	flow-children: right;
	margin-bottom: 6px;
}

Label.ph-stat-name
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	font-size: 12;
	letter-spacing: 1.4px;
	text-transform: uppercase;
	color: #9aa2ac;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
}

Label.ph-stat-val
{
	width: 72px;
	height: 100%;
	font-size: 12;
	color: #f2f4f7;
	text-align: right;
	text-overflow: ellipsis;
	white-space: nowrap;
	vertical-align: middle;
}

.ph-stat-track
{
	width: 100%;
	height: 7px;
	flow-children: none;
	border-radius: 4px;
	background-color: #ffffff12;
	overflow: clip;
}

.ph-stat-fill
{
	height: 100%;
	width: 100%;
	border-radius: 4px;
	background-color: gradient( linear, 0% 0%, 100% 0%, from( #f0a531 ), to( #ffd27a ) );
	transition-property: clip;
	transition-duration: 0.35s;
	clip: rect( 0%, 2%, 100%, 0% );
}

.ph-stat-fill.p100 { clip: rect( 0%, 100%, 100%, 0% ); }
.ph-stat-fill.p90 { clip: rect( 0%, 90%, 100%, 0% ); }
.ph-stat-fill.p80 { clip: rect( 0%, 80%, 100%, 0% ); }
.ph-stat-fill.p70 { clip: rect( 0%, 70%, 100%, 0% ); }
.ph-stat-fill.p60 { clip: rect( 0%, 60%, 100%, 0% ); }
.ph-stat-fill.p50 { clip: rect( 0%, 50%, 100%, 0% ); }
.ph-stat-fill.p40 { clip: rect( 0%, 40%, 100%, 0% ); }
.ph-stat-fill.p30 { clip: rect( 0%, 30%, 100%, 0% ); }
.ph-stat-fill.p20 { clip: rect( 0%, 20%, 100%, 0% ); }
.ph-stat-fill.p10 { clip: rect( 0%, 10%, 100%, 0% ); }
.ph-stat-fill.p0 { clip: rect( 0%, 2%, 100%, 0% ); }

/* PlayerInfo — bottom-center strip over the stock logo (hider carousel / seeker class). Not clickable. */

.PlayerInfo
{
	width: 100%;
	height: 116px;
	vertical-align: bottom;
	margin-bottom: 4px;
	flow-children: none;
}

.PlayerInfoCard
{
	width: 430px;
	height: 100%;
	horizontal-align: center;
	flow-children: none;
}

.PlayerInfo .ph-bg
{
	box-shadow: #00000066 0px 8px 24px 0px;
}

.PlayerInfo .ph-bar
{
	width: 2px;
}

.PlayerInfoBody
{
	width: 100%;
	height: 100%;
	flow-children: down;
	padding: 5px 10px 4px 10px;
	z-index: 2;
}

.PlayerInfoHider
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
}

.PlayerInfoHider.is-off
{
	visibility: collapse;
}

.PlayerInfoStrip
{
	width: 100%;
	height: 52px;
	flow-children: right;
}

.PlayerInfoThumb
{
	vertical-align: middle;
	overflow: clip;
	border-radius: 2px;
	background-color: #1e2834;
	background-repeat: no-repeat;
	background-position: center;
	/* Fill slot height; keep aspect ratio and crop left/right (no vertical squash). */
	background-size: auto 100%;
	margin-right: 4px;
}

.PlayerInfoThumb:last-child
{
	margin-right: 0px;
}

.PlayerInfoThumbSide
{
	width: fill-parent-flow( 1.0 );
	height: 36px;
	opacity: 0.45;
}

.PlayerInfoThumbNear
{
	width: fill-parent-flow( 1.15 );
	height: 44px;
	opacity: 0.7;
}

.PlayerInfoThumbCenter
{
	width: fill-parent-flow( 1.45 );
	height: 52px;
}

.PlayerInfoHint
{
	width: 100%;
	font-size: 10;
	color: #e8eef4;
	text-align: center;
	text-overflow: ellipsis;
	white-space: nowrap;
	margin-top: 3px;
}

.PlayerInfoSeeker
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
}

.PlayerInfoSeeker.is-off
{
	visibility: collapse;
}

.PlayerInfoSeekerText
{
	width: 100%;
	flow-children: down;
	vertical-align: middle;
}

.PlayerInfoName
{
	width: 100%;
	font-size: 13.65;
	letter-spacing: 1px;
	color: #e8eef4;
	text-align: center;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.PlayerInfoMeta
{
	width: 100%;
	font-size: 11.55;
	color: #f0a531;
	text-align: center;
	margin-top: 3px;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.PlayerInfoVer
{
	width: 100%;
	font-size: 10.5;
	color: #c5ced6;
	text-align: center;
	margin-top: 2px;
}

/* HiderModes — transparent bottom-right pair (wall left, look right); own layout entity. */
.HiderModes
{
	width: fit-children;
	height: 100px;
	horizontal-align: right;
	vertical-align: bottom;
	margin-right: 10px;
	margin-bottom: 10px;
	flow-children: right;
}

.HiderModes.ph-off
{
	visibility: collapse;
}

.InfoModeTile
{
	width: 100px;
	height: 100px;
	margin-right: 6px;
	opacity: 0.4;
	flow-children: none;
	overflow: clip;
	transition-property: opacity;
	transition-duration: 0.15s;
}

.InfoModeTile:last-child
{
	margin-right: 0px;
}

.InfoModeTile.is-on
{
	opacity: 1;
}

.InfoWall.is-off
{
	visibility: collapse;
}

.InfoModeIcon
{
	/* Explicit px — % under flow-children:none collapses with no paint box. */
	width: 100px;
	height: 100px;
	background-repeat: no-repeat;
	background-position: center;
	/* Stretch to fill the 100×100 square (source PNGs are ~1450px). */
	background-size: 100% 100%;
}

.InfoLook .InfoModeIcon
{
	background-image: url("s2r://panorama/images/custom_game/prophunt/ui/free_look.vtex");
}

.InfoWall .InfoModeIcon
{
	background-image: url("s2r://panorama/images/custom_game/prophunt/ui/wall_snap.vtex");
}

/* PropMenu — left list card + right-side tweak sliders; grid stays fullscreen. */

.PropMenuShell
{
	width: 100%;
	height: fit-children;
	vertical-align: middle;
	padding-left: 28px;
	padding-right: 28px;
	flow-children: right;
	z-index: 100;
}

.PropMenu
{
	width: 350px;
}

.PropMenuSpacer
{
	width: fill-parent-flow( 1.0 );
	height: 1px;
}

.PropMenuSpacer.is-off
{
	visibility: collapse;
	width: 0px;
}

.PropMenuSizeBtn
{
	flow-children: none;
	margin-right: 6px;
}

Label.PropMenuSizeLabel
{
	font-size: 18;
	color: #ffffff;
}

.PropMenuContent
{
	width: 100%;
	height: fit-children;
	horizontal-align: center;
	flow-children: down;
	overflow: noclip noclip;
	z-index: 2;
}

.PropMenuBody
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 14px 18px 16px 18px;
}

.PropMenuCatStrip
{
	width: 100%;
	flow-children: right;
	vertical-align: middle;
}

.PropMenuCatBtn
{
	width: 32px;
	height: 32px;
	background-color: #ffffff0d;
	border: 0px solid transparent;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.PropMenuCatBtn:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.PropMenuCatBtn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.PropMenuCatArrow
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 18;
	color: #e8eef4;
}

.PropMenuCatName
{
	width: fill-parent-flow( 1.0 );
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 18;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #f0a531;
	white-space: nowrap;
	text-overflow: ellipsis;
	margin-left: 8px;
	margin-right: 8px;
}

.PropMenuDivider
{
	width: 100%;
	height: 1px;
	background-color: #d9d9d90a;
	margin-top: 10px;
	margin-bottom: 10px;
}

.PropMenuRows
{
	width: 100%;
	flow-children: down;
}

.PropMenuRow
{
	width: 100%;
	height: 40px;
	margin: 2px 0px;
	flow-children: right;
	background-color: #ffffff0d;
	border-radius: 3px;
	border: 1px solid #00000000;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.PropMenuRow.playing
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
}

.PropMenuRow.playing:hover
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
}

.PropMenuRow.is-empty
{
	background-color: #060a1073;
	border: 1px dashed #6e7d8c47;
	opacity: 0.55;
}

.PropMenuRowMain,
.PropMenuRowMain:hover,
.PropMenuRowMain:active
{
	wash-color: none;
}







.PropMenuFavBtn
{
	width: 22px;
	height: 100%;
	background-color: #00000000;
	border: 0px solid transparent;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.PropMenuFavBtn:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.PropMenuFavBtn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.PropMenuFavBtn.is-on
{
	background-color: #f0a53166;
}

.PropMenuFavBtn.is-on:hover
{
	background-color: #f0a53155;
}

.PropMenuFavStar
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 14;
	color: #8b8f94;
}

.PropMenuFavBtn.is-on .PropMenuFavStar
{
	color: #f0a531;
}

.PropMenuRow.is-empty .PropMenuFavBtn
{
	visibility: collapse;
}

.PropMenuRowMain
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: right;
	background-color: #00000000;
	border: 0px solid transparent;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.PropMenuRow:not(.is-empty) .PropMenuRowMain:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.PropMenuRow:not(.is-empty) .PropMenuRowMain:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.PropMenuRowImg
{
	width: 40px;
	height: 28px;
	vertical-align: middle;
	margin-left: 4px;
	margin-right: 8px;
	background-repeat: no-repeat;
	background-position: center;
	background-size: contains;
}

.PropMenuRow.is-empty .PropMenuRowImg
{
	visibility: collapse;
}

.PropMenuRowText
{
	width: fill-parent-flow( 1.0 );
	height: fit-children;
	flow-children: down;
	vertical-align: middle;
}

.PropMenuRowLabel
{
	width: 100%;
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.PropMenuRowMeta
{
	width: 100%;
	font-size: 11;
	color: #8b8f94;
	white-space: nowrap;
	text-overflow: ellipsis;
	visibility: collapse;
}

.PropMenuRow.has-meta .PropMenuRowMeta
{
	visibility: visible;
}

.PropMenuRow.is-empty .PropMenuRowLabel,
.PropMenuRow.is-empty .PropMenuRowMeta
{
	visibility: collapse;
}

.PropMenuRowKey
{
	width: 22px;
	font-size: 13;
	color: #f0a531;
	vertical-align: middle;
	margin-right: 8px;
	text-align: center;
	visibility: collapse;
}

.PropMenu.mode-keys .PropMenuRowKey,
.PropMenu.mode-all .PropMenuRowKey
{
	visibility: visible;
}

.PropMenu.mode-keys .PropMenuRow.is-empty .PropMenuRowKey,
.PropMenu.mode-all .PropMenuRow.is-empty .PropMenuRowKey
{
	visibility: collapse;
}

.PropMenuFooter
{
	width: 100%;
	flow-children: right;
	vertical-align: middle;
	horizontal-align: center;
}

.PropMenuPageBtn
{
	width: 64px;
	height: 32px;
	flow-children: none;
	margin: 0px 4px;
	background-color: #ffffff0d;
	border: 0px solid transparent;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.PropMenuPageBtn:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.PropMenuPageBtn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.PropMenuPage
{
	width: fill-parent-flow( 1.0 );
	font-size: 13;
	letter-spacing: 1px;
	color: #8b8f94;
	vertical-align: middle;
	text-align: center;
}

/* Fullscreen card grid. Spacers (not padding) keep flow children inside the frame —
   width/height 100% children measure the border box and ignore padding. */
.PropGrid
{
	width: 100%;
	height: 100%;
	flow-children: down;
	overflow: clip;
	z-index: 200;
}

.PropGridTopGap
{
	width: 100%;
	height: 68px;
}

.PropGridBottomGap
{
	width: 100%;
	height: 36px;
}

.PropGridMid
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
}

/* Definite height under a down parent so side gaps can use height:100% in a right row. */
.PropGridHRow
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.PropGridSideGap
{
	width: 36px;
	height: 100%;
}

/* flow-children:none — ph-bg / ph-bar / content overlay; no ignore-parent-flow needed. */
.PropGridFrame
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: none;
	border-radius: 4px;
	overflow: clip;
}

.PropGrid .PropMenuContent
{
	width: 100%;
	height: 100%;
	overflow: clip;
}

.PropGridBody
{
	height: fill-parent-flow( 1.0 );
}

/* Shop-style exclusive filters. Two rows — right-wrap is not accepted here. */
.PropGridFilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: down;
}

.PropGridFilterRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	padding-bottom: 4px;
}

.PropGridFilterBtn
{
	height: 26px;
	flow-children: none;
	padding-left: 10px;
	padding-right: 10px;
	margin-right: 6px;
	margin-bottom: 2px;
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	border-radius: 3px;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.PropGridFilterBtn:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.PropGridFilterBtn:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
	sound: "UIPanorama.generic_button_press";
}

.PropGridFilterBtn.is-on
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
}

.PropGridFilterBtn.is-on:hover
{
	background-color: #f0a53144;
	border: 1px solid #f0a531;
}

.PropGridFilterBtn.is-disabled
{
	opacity: 0.35;
	saturation: 0.15;
}

.PropGridFilterBtn.is-disabled:hover,
.PropGridFilterBtn.is-disabled:active
{
	background-color: #ffffff0d;
	border: 1px solid #00000000;
	cursor: default;
	sound: none;
}

.PropGridFilterBtn.is-empty
{
	visibility: collapse;
	width: 0px;
	padding-left: 0px;
	padding-right: 0px;
	margin-right: 0px;
	margin-bottom: 0px;
}

Label.PropGridFilterLabel
{
	font-size: 11.55;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
	vertical-align: middle;
}

.PropGridCards
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
}

.PropGridRow
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
}

/* 12px gap between rows (margin on fill-parent-flow rows is squished). */
.PropGridRowGap
{
	width: 100%;
	height: 12px;
}

/* Inner right-flow: definite % height so card height:100% is not rewritten to fill-parent-flow. */
.PropGridRowFlow
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.PropGridCard
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	background-color: #ffffff0d;
	border-radius: 3px;
	border: 1px solid #00000000;
	margin-right: 12px;
	/* Top padding for title/meta only — image is flush left / right / bottom. */
	padding-top: 8px;
	padding-right: 0px;
	padding-bottom: 0px;
	padding-left: 0px;
	overflow: clip clip;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.PropGridCard:last-child
{
	margin-right: 0px;
}

.PropGridCard.playing
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
}

.PropGridCard.playing:hover
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
}

.PropGridCard.is-empty
{
	background-color: #060a1073;
	border: 1px dashed #6e7d8c47;
	opacity: 0.45;
}

.PropGridHeader
{
	width: 100%;
	height: 46px;
	flow-children: right;
	padding-left: 4px;
	padding-right: 4px;
}


.PropGridCard.is-empty .PropMenuFavBtn
{
	visibility: collapse;
}

.PropGridHeader .PropMenuFavBtn
{
	width: 22px;
	height: 100%;
}

.PropGridHeaderText
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	vertical-align: middle;
	padding-left: 4px;
	padding-right: 4px;
}

Label.PropGridTitle
{
	width: 100%;
	height: 20px;
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	text-align: center;
	color: #e8eef4;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* Always reserved so cards with/without meta share the same header height. */
Label.PropGridMeta
{
	width: 100%;
	height: 18px;
	font-size: 13;
	text-align: center;
	color: #e8eef4;
	white-space: nowrap;
	text-overflow: ellipsis;
	margin-top: 2px;
}

.PropGridCard:not(.has-meta) .PropGridMeta
{
	opacity: 0;
}

.PropGridCardBody,
.PropGridCardBody:hover,
.PropGridCardBody:active
{
	wash-color: none;
}

.PropGridCardBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
	background-color: #00000000;
	border: 0px solid transparent;
	border-radius: 0px;
	margin-top: 6px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.PropGridCard:not(.is-empty) .PropGridCardBody:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.PropGridCard:not(.is-empty) .PropGridCardBody:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.PropGridImg
{
	width: 100%;
	height: 100%;
	background-repeat: no-repeat;
	background-position: center;
	background-size: contains;
}

.PropGridCard.is-empty .PropGridHeader,
.PropGridCard.is-empty .PropGridImg
{
	visibility: collapse;
}

/* Live scale / hue / intensity sliders — same ph-bg / ph-bar chrome as other overlays. */
.PropSliders
{
	width: fit-children;
	height: 100%;
	flow-children: none;
	border-radius: 4px;
	overflow: noclip noclip;
}

.PropSliders.is-off
{
	visibility: collapse;
	width: 0px;
}

.PropSlidersContent
{
	width: fit-children;
	height: 100%;
	flow-children: right;
	padding: 0px 12px 0px 14px;
	overflow: noclip noclip;
	z-index: 2;
}

.PropSliderCol
{
	width: 64px;
	height: 100%;
	flow-children: down;
	margin-left: 4px;
	margin-right: 4px;
}

/* Hidden when the prop disables that axis — collapses so remaining columns shrink. */
.PropSliderCol.is-off
{
	visibility: collapse;
	width: 0px;
	margin-left: 0px;
	margin-right: 0px;
}

/* In-flow top margin (not content padding) so height:100% columns stay inside the panel.
   noclip + horizontal-align so titles center (shrink left-paints). */
Label.PropSliderLabel
{
	width: 100%;
	horizontal-align: center;
	font-size: 10;
	text-transform: uppercase;
	color: #8b8f94;
	text-align: center;
	text-overflow: noclip;
	margin-top: 10px;
	margin-bottom: 6px;
	white-space: nowrap;
}

.PropSliderTrack
{
	width: 28px;
	height: fill-parent-flow( 1.0 );
	horizontal-align: center;
	flow-children: none;
	background-color: #ffffff0d;
	border-radius: 3px;
	overflow: clip clip;
}

/* Even HSV stops: 0° red → 60° yellow → 120° green → 180° cyan → 240° blue → 300° magenta → 360° red. */
.PropSliderTrackHue
{
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #ff0000 ), color-stop( 0.1667, #ffff00 ), color-stop( 0.3333, #00ff00 ), color-stop( 0.5, #00ffff ), color-stop( 0.6667, #0000ff ), color-stop( 0.8333, #ff00ff ), to( #ff0000 ) );
}

.PropSliderTrackValue
{
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #ffffff ), to( #000000 ) );
}

.PropSliderHits
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

.PropSliderHit
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
	background-color: #00000000;
	border: 0px solid transparent;
}

/* Per-hit fill so the #f0a531 ends on the same edge as the gold stripe. */
.PropSliderSeg
{
	width: 100%;
	height: 100%;
	background-color: #f0a531;
	opacity: 0;
}

.PropSliderHit.is-filled .PropSliderSeg
{
	opacity: 0.9;
}

.PropSliderHit:hover
{
	background-color: #ffffff22;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.PropSliderHit:active
{
	background-color: #ffffff33;
	sound: "UIPanorama.generic_button_press";
}

/* Gold stripe — size/tint at top of the hit (matches high-edge value); hue centered.
   Opacity (not visibility) so is-on can re-show after the mark moves. */
.PropSliderStripe
{
	width: 100%;
	height: 3px;
	vertical-align: top;
	background-color: #ffe566;
	box-shadow: #000000aa 0px 0px 2px 0px;
	opacity: 0;
}

.PropSliderTrackHue .PropSliderStripe
{
	vertical-align: middle;
}

.PropSliderHit.is-on .PropSliderStripe
{
	opacity: 1;
}

.PropSliderHit.is-on:hover
{
	background-color: #ffe56622;
}

.PropSliderReset
{
	width: 28px;
	height: 22px;
	horizontal-align: center;
	margin-top: 6px;
	margin-bottom: 12px;
	background-color: #ffffff0d;
	border: 0px solid transparent;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.PropSliderReset:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.PropSliderReset:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.PropSliderResetLabel
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 11;
	letter-spacing: 1px;
	color: #8b8f94;
}

.PropSliderReset:hover .PropSliderResetLabel
{
	color: #ffffff;
}

/* SoundMenu — middle-left clickable list. */

.SoundMenu
{
	width: 350px;
	horizontal-align: left;
	vertical-align: middle;
	margin-left: 28px;
	z-index: 100;
}

.SoundContent
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	overflow: noclip noclip;
	z-index: 2;
}

.SoundStopBtn
{
	flow-children: none;
	margin-right: 6px;
}

.SoundStopBtn.active
{
	background-color: #ffffff1c;
}

Label.SoundStopLabel
{
	font-size: 12;
	color: #8b8f94;
}

.SoundStopBtn.active Label.SoundStopLabel,
.SoundStopBtn:hover Label.SoundStopLabel
{
	color: #ffffff;
}

.SoundBody
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	padding: 12px 14px 14px 18px;
}

.SoundMeta
{
	width: 100%;
	flow-children: right;
	margin-bottom: 6px;
}

.SoundPage
{
	width: 100%;
	font-size: 12;
	color: #f0a531;
	text-align: right;
}

.SoundMenu.cooldown .SoundOptions,
.SoundMenu.disabled .SoundOptions
{
	opacity: 0.45;
}

.SoundOptions
{
	width: 100%;
	flow-children: down;
}

.SoundRowOuter
{
	width: 100%;
	height: 34px;
	flow-children: right;
	margin-bottom: 4px;
}

.SoundRow
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: right;
	background-color: #ffffff0d;
	border-radius: 3px;
	border: 1px solid #00000000;
	overflow: clip;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.SoundRow:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
}

.SoundRow:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
}

.SoundRow.playing
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
}

.SoundRow.playing:hover
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
}

.SoundRow.empty
{
	opacity: 0.3;
}

.SoundRow.empty:hover,
.SoundRow.empty:active
{
	background-color: #ffffff0d;
	border: 1px solid #00000000;
}

.SoundFlag
{
	width: 48px;
	height: 100%;
	flow-children: none;
	border-top-left-radius: 3px;
	border-bottom-left-radius: 3px;
	overflow: clip;
	opacity: 0.7;
}

.SoundFlag.is-off
{
	visibility: collapse;
}

/* Stock flag SVGs need <Image> — background-image drops the US blue canton. */
.SoundFlagImg
{
	width: 100%;
	height: 100%;
	opacity: 0;
}

