.SoundRowContent
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: right;
	padding: 0px 8px;
}

.SoundLabel
{
	width: fill-parent-flow( 1.0 );
	font-size: 14;
	color: #e8eef4;
	vertical-align: middle;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.SoundDur
{
	font-size: 11;
	color: #8b8f94;
	vertical-align: middle;
	margin-left: 6px;
}

.SoundFavBtn
{
	width: 22px;
	max-width: 22px;
	height: 100%;
	margin-left: 2px;
	padding: 0px;
	background-color: #00000000;
	border: 0px solid transparent;
	border-radius: 3px;
	overflow: clip;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.SoundFavBtn.is-off
{
	visibility: collapse;
}

.SoundFavBtn:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.SoundFavBtn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.SoundFavBtn.is-on
{
	background-color: #f0a53166;
}

.SoundFavBtn.is-on:hover
{
	background-color: #f0a53155;
}

.SoundFavStar
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-size: 14;
	color: #8b8f94;
}

.SoundFavBtn.is-on .SoundFavStar
{
	color: #f0a531;
}

/* Overlay play progress — fixed row height so idle/playing never resizes the button. */
.SoundPlayFill
{
	width: 100%;
	height: 3px;
	ignore-parent-flow: true;
	horizontal-align: left;
	vertical-align: bottom;
	background-color: #f0a531;
	opacity: 0;
	border-bottom-left-radius: 3px;
	border-bottom-right-radius: 3px;
	transition-property: clip, opacity;
	transition-duration: 0.12s;
	clip: rect( 0%, 2%, 100%, 0% );
}

.SoundPlayFill.playing
{
	opacity: 1;
}

.SoundPlayFill.complete
{
	opacity: 1;
	background-color: #7dffa0;
}

.SoundPlayFill.p100 { clip: rect( 0%, 100%, 100%, 0% ); }
.SoundPlayFill.p90 { clip: rect( 0%, 90%, 100%, 0% ); }
.SoundPlayFill.p80 { clip: rect( 0%, 80%, 100%, 0% ); }
.SoundPlayFill.p70 { clip: rect( 0%, 70%, 100%, 0% ); }
.SoundPlayFill.p60 { clip: rect( 0%, 60%, 100%, 0% ); }
.SoundPlayFill.p50 { clip: rect( 0%, 50%, 100%, 0% ); }
.SoundPlayFill.p40 { clip: rect( 0%, 40%, 100%, 0% ); }
.SoundPlayFill.p30 { clip: rect( 0%, 30%, 100%, 0% ); }
.SoundPlayFill.p20 { clip: rect( 0%, 20%, 100%, 0% ); }
.SoundPlayFill.p10 { clip: rect( 0%, 10%, 100%, 0% ); }
.SoundPlayFill.p0 { clip: rect( 0%, 2%, 100%, 0% ); }

.SoundFooter
{
	width: 100%;
	flow-children: right;
	margin-top: 8px;
	padding-top: 6px;
	border-top: 1px solid #d9d9d90a;
}

.SoundFooterBtn
{
	width: fill-parent-flow( 1.0 );
	flow-children: none;
	padding: 6px 4px;
	margin: 0px 2px;
	background-color: #ffffff0d;
	border-radius: 3px;
	border: 1px solid #00000000;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.SoundFooterBtn:hover
{
	background-color: #ffffff1c;
	border: 1px solid #f0a53166;
}

.SoundFooterBtn:active
{
	background-color: #ffffff2e;
	border: 1px solid #f0a531;
}

/* RoundStatus — top-center phase card. z-index above fullscreen menus. */
.HudScreen
{
	z-index: 100000;
}

/* HiderModes — under every other custom HUD root (menus / player info / timer). */
.HudScreen.HiderModesScreen
{
	z-index: 99998;
}

.RoundStatus
{
	width: 82px;
	height: 60px;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 4px;
	flow-children: down;
}

.RoundStatus .ph-bg
{
	ignore-parent-flow: true;
}

.CdLabelRow,
.CdTimeRow,
.CdRail
{
	width: 100%;
}

/* Center by panel align — shrink left-paints and ignores text-align. */
.CdLabelRow,
.CdTimeRow
{
	height: fit-children;
	flow-children: none;
}

Label.CdLabel,
Label.CdTime
{
	width: fit-children;
	height: fit-children;
	horizontal-align: center;
	white-space: nowrap;
	text-overflow: noclip;
}

Label.CdLabel
{
	font-size: 16;
	line-height: 16px;
	color: #f0a531;
	text-transform: uppercase;
}

Label.CdTime
{
	margin-top: -6px;
	font-size: 40;
	line-height: 32px;
	color: #e8eef4;
	transition-property: transform;
	transition-duration: 0.2s;
}

.CdTime.tick-a,
.CdTime.tick-b
{
	transform: scale3d( 1.06, 1.06, 1 );
}

/* Warmup count: 0 players red → full lobby green. Hue class on RoundStatus. */
.RoundStatus.hue0 Label.CdTime { color: #ff4040ff; }
.RoundStatus.hue1 Label.CdTime { color: #ff5428ff; }
.RoundStatus.hue2 Label.CdTime { color: #ff6c22ff; }
.RoundStatus.hue3 Label.CdTime { color: #f88820ff; }
.RoundStatus.hue4 Label.CdTime { color: #e8a418ff; }
.RoundStatus.hue5 Label.CdTime { color: #d4bc20ff; }
.RoundStatus.hue6 Label.CdTime { color: #b4cc28ff; }
.RoundStatus.hue7 Label.CdTime { color: #90d430ff; }
.RoundStatus.hue8 Label.CdTime { color: #70dc38ff; }
.RoundStatus.hue9 Label.CdTime { color: #58dc44ff; }
.RoundStatus.hue10 Label.CdTime { color: #9ccf4f; }

.CdRail
{
	height: 3px;
	background-color: #ffffff1f;
	border-radius: 0px 0px 4px 4px;
	overflow: clip;
}

.CdRail.is-off
{
	visibility: collapse;
}

.CdFill
{
	height: 100%;
	width: 100%;
	background-color: #f0a53166;
	transition-property: clip;
	transition-duration: 0.35s;
	clip: rect( 0%, 100%, 100%, 0% );
}

/* Tutorial tip — kit-reveal card under RoundStatus (4 + 60 + 8). Bg on the
   sized panel; a child .ph-bg at 100% under fit-children collapses. */
.TutorialTip
{
	width: 520px;
	height: fit-children;
	horizontal-align: center;
	vertical-align: top;
	margin-top: 72px;
	flow-children: down;
	padding-top: 10px;
	padding-right: 16px;
	padding-bottom: 10px;
	padding-left: 16px;
	border: 1px solid #ffffff14;
	border-top: 2px solid #f0a531;
	border-radius: 3px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #12171e80 ), to( #0b0f1480 ) );
	box-shadow: #00000080 0px 4px 16px 0px;
}

Label.TutorialTipText
{
	width: 100%;
	font-size: 15.4;
	line-height: 19.8px;
	color: #e8eef4;
	text-align: center;
	white-space: normal;
}

.CdFill.p100 { clip: rect( 0%, 100%, 100%, 0% ); }
.CdFill.p90 { clip: rect( 0%, 90%, 100%, 0% ); }
.CdFill.p80 { clip: rect( 0%, 80%, 100%, 0% ); }
.CdFill.p70 { clip: rect( 0%, 70%, 100%, 0% ); }
.CdFill.p60 { clip: rect( 0%, 60%, 100%, 0% ); }
.CdFill.p50 { clip: rect( 0%, 50%, 100%, 0% ); }
.CdFill.p40 { clip: rect( 0%, 40%, 100%, 0% ); }
.CdFill.p30 { clip: rect( 0%, 30%, 100%, 0% ); }
.CdFill.p20 { clip: rect( 0%, 20%, 100%, 0% ); }
.CdFill.p10 { clip: rect( 0%, 10%, 100%, 0% ); }
.CdFill.p0 { clip: rect( 0%, 2%, 100%, 0% ); }

/* Fullscreen seeker weapon menu. Shell padding via .ph-fs. */

.WeaponMenu
{
	z-index: 200;
}

.WeaponMenuContent
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

.WeaponMenuShopLink,
.WeaponMenuShopLink:hover,
.WeaponMenuShopLink:active
{
	wash-color: none;
}

.WeaponMenuShopLink
{
	height: 28px;
	flow-children: none;
	vertical-align: middle;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 12px;
	background-color: #f0a53118;
	border: 1px solid #f0a531;
	border-radius: 3px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.WeaponMenuShopLink:hover
{
	background-color: #f0a53133;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.WeaponMenuShopLink:active
{
	background-color: #f0a53155;
	sound: "UIPanorama.generic_button_press";
}

/* Fit-children button — no ph-btn-label (width:100% needs a sized parent). */
Label.WeaponMenuShopLinkLabel
{
	vertical-align: middle;
	font-size: 12;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #f0a531;
}

.WeaponMenuMain
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-left: 18px;
	padding-right: 18px;
	padding-top: 10px;
	padding-bottom: 12px;
}

.WeaponMenuMainFlow
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.WeaponShop
{
	width: fill-parent-flow( 2.0 );
	height: 100%;
	flow-children: down;
	padding-right: 12px;
}

.WeaponPresets
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	padding-left: 12px;
	border-left: 1px solid #d9d9d90a;
}

.WeaponPresetToolbar
{
	width: 100%;
	height: 32px;
	flow-children: right;
	margin-bottom: 8px;
}

.WeaponPresetAction,
.WeaponPresetAction:hover,
.WeaponPresetAction:active
{
	wash-color: none;
}

.WeaponPresetAction
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: none;
	background-color: #ffffff0d;
	border-radius: 3px;
	margin-right: 6px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.WeaponPresetAction:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.WeaponPresetAction:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

Label.WeaponPresetActionLabel
{
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
}

.WeaponPresetList
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	overflow: squish scroll;
}

.WeaponPresetRow
{
	width: 100%;
	height: 40px;
	flow-children: down;
	background-color: #ffffff0d;
	border-radius: 3px;
	margin-bottom: 4px;
	padding-left: 10px;
	padding-right: 10px;
	border: 1px solid transparent;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.WeaponPresetRow:not(.is-empty):hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.WeaponPresetRow:not(.is-empty):active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.WeaponPresetRow.is-selected
{
	border: 1px solid #f0a531;
	background-color: #f0a53122;
}

.WeaponPresetRow.is-broke
{
	opacity: 0.45;
}

.WeaponPresetAction.is-disabled
{
	opacity: 0.35;
	saturation: 0.15;
}

.WeaponPresetRow.is-empty
{
	visibility: collapse;
	height: 0px;
	margin-bottom: 0px;
}

.WeaponPresetName
{
	width: 100%;
	font-size: 13;
	color: #e8eef4;
	vertical-align: bottom;
}

.WeaponPresetMeta
{
	width: 100%;
	font-size: 11;
	color: #8b8f94;
	vertical-align: top;
}

.WeaponSection
{
	width: 100%;
	flow-children: down;
	margin-bottom: 8px;
}

.WeaponSectionPrimary
{
	height: fill-parent-flow( 2.2 );
}

.WeaponSectionSecondary
{
	height: fill-parent-flow( 1.0 );
}

.WeaponSectionUtils
{
	height: fill-parent-flow( 0.85 );
}

Label.WeaponSectionLabel
{
	width: 100%;
	font-size: 13;
	letter-spacing: 2px;
	text-transform: uppercase;
	color: #f0a531;
	margin-bottom: 4px;
}

.WeaponSectionCards
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
}

.WeaponRow
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	margin-bottom: 6px;
}

.WeaponRowFlow
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.WeaponCard,
.WeaponCard:hover,
.WeaponCard:active
{
	wash-color: none;
}

.WeaponCard
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	background-color: #ffffff0d;
	border-radius: 3px;
	margin-right: 6px;
	padding-top: 6px;
	padding-left: 0px;
	padding-right: 0px;
	padding-bottom: 0px;
	border: 1px solid transparent;
	transition-property: background-color, border;
	transition-duration: 0.15s;
}

.WeaponCard:not(.is-empty):hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.WeaponCard:not(.is-empty):active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.WeaponCard.is-selected
{
	border: 1px solid #f0a531;
	background-color: #f0a53122;
}

.WeaponCard.is-broke
{
	opacity: 0.45;
}

.WeaponCard.is-disabled
{
	opacity: 0.35;
	saturation: 0.15;
}

.WeaponCard.is-empty
{
	visibility: collapse;
	width: 0px;
	margin-right: 0px;
}

.WeaponCardHead
{
	width: 100%;
	height: 16px;
	flow-children: right;
	padding-left: 6px;
	padding-right: 6px;
}

Label.WeaponCardTitle
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-size: 12;
	letter-spacing: 1px;
	text-transform: uppercase;
	text-align: left;
	color: #e8eef4;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.WeaponCardImg
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	margin-top: 4px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	background-size: auto 100%;
	overflow: clip;
}

Label.WeaponCardMeta
{
	vertical-align: middle;
	font-size: 10;
	text-align: right;
	color: #9ccf4f;
	white-space: nowrap;
	margin-left: 4px;
}

.WeaponCardCount
{
	width: 100%;
	font-size: 12;
	text-align: center;
	color: #f0a531;
	margin-top: 0px;
	padding-left: 6px;
	padding-right: 6px;
}

.WeaponUtilCard
{
	padding-bottom: 4px;
}

.WeaponUtilBtns
{
	width: 100%;
	height: 28px;
	flow-children: right;
	margin-top: 4px;
	padding-left: 6px;
	padding-right: 6px;
}

.WeaponUtilBtn
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: none;
	background-color: #ffffff0d;
	border-radius: 3px;
	margin-right: 4px;
	transition-property: background-color;
	transition-duration: 0.15s;
}

.WeaponUtilBtn:hover
{
	background-color: #ffffff1c;
	cursor: pointer;
	sound: "UIPanorama.generic_button_rollover";
}

.WeaponUtilBtn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.WeaponUtilBtn.is-disabled
{
	opacity: 0.35;
}

Label.WeaponUtilBtnLabel
{
	font-size: 18;
	color: #e8eef4;
}

